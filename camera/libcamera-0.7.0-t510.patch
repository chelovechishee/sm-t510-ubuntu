+# SPDX-License-Identifier: CC0-1.0
+%YAML 1.1
+---
+# S5K4HA, the rear camera of the Galaxy Tab A 10.1 (2019), SM-T510.
+# Picked by eye on a room scene, not calibrated against a chart: a mild
+# colour matrix for saturation.
+# The sensor's black level is 64 at 10 bits; a higher one (against the glare
+# of a lens with no cover glass) tinted dark scenes.
+version: 1
+algorithms:
+  - BlackLevel:
+      blackLevel: 4096
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1.6, -0.4, -0.2,
+                -0.3,  1.6, -0.3,
+                -0.1, -0.6,  1.7 ]
+  - Adjust:
+  - Agc:
+...

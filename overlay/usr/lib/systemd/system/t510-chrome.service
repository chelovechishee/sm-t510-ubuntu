[Unit]
Description=Install Google Chrome from Google's repository (first time online)
# Chrome may not be redistributed, so the image carries only Google's apt
# source and key; the browser comes straight from dl.google.com
ConditionPathExists=!/opt/google/chrome/chrome
Wants=network-online.target
After=network-online.target
# no network yet (Wi-Fi not set up): try again until it works
StartLimitIntervalSec=0

[Service]
# one at a time: t510-chrome and t510-update start together on a new
# install, and apt-get update does not wait for a lock (DPkg::Lock::Timeout
# covers dpkg only), the second one failed at once
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/flock /run/lock/t510-apt /usr/bin/apt-get -o DPkg::Lock::Timeout=600 update
ExecStart=/usr/bin/flock /run/lock/t510-apt /usr/bin/apt-get -o DPkg::Lock::Timeout=600 -y install google-chrome-stable
TimeoutStartSec=30min
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target

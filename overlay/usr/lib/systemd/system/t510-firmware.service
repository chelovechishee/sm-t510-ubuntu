[Unit]
Description=Samsung firmware for the audio DSP, DVFS and Bluetooth, start their drivers
DefaultDependencies=no
WantsMountsFor=/vendor /efs
After=systemd-remount-fs.service systemd-udevd.service
Before=sysinit.target display-manager.service t510-audio.service bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/t510-firmware

[Install]
WantedBy=sysinit.target

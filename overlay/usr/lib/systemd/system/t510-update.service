[Unit]
Description=Bring the SM-T510 packages up to date (first time online)
# Images are made for large versions only; fixes come from our apt
# repository (docs/maintenance.md). A new install takes them the first time
# it is online, later ones come with the usual updates
ConditionPathExists=!/var/lib/t510/updated
Wants=network-online.target
After=network-online.target
# no network yet (Wi-Fi not set up): try again until it works
StartLimitIntervalSec=0

[Service]
# one at a time: t510-chrome and t510-update start together on a new
# install, and apt-get update does not wait for a lock (DPkg::Lock::Timeout
# covers dpkg only), the second one failed at once
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/flock /run/lock/t510-apt /usr/bin/apt-get -o DPkg::Lock::Timeout=600 update
ExecStart=/usr/bin/flock /run/lock/t510-apt /usr/bin/apt-get -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold -y install --only-upgrade t510-archive-keyring t510-support t510-kernel
ExecStart=/usr/bin/touch /var/lib/t510/updated
TimeoutStartSec=30min
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target

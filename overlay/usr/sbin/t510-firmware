#!/bin/sh
# Re-probe the drivers that deferred without Samsung's firmware, once it can be
# read. None of it ships with this project:
#   calliope_{sram,dram}.bin  audio DSP: /lib/firmware has only links to the
#                             tablet's own stock files on Android's VENDOR
#                             partition (/vendor/firmware, mounted read-only)
#   exynos7885_acpm_fvp.fw    CPU/GPU DVFS: Samsung's GPL kernel tree on GitHub;
#                             the installer puts it in place, --fetch gets it
# Usage: t510-firmware [--fetch]
set -eu

FW=/lib/firmware
FVP=exynos7885_acpm_fvp.fw
FVP_URL=https://raw.githubusercontent.com/gta3xlwifi-dev/android_kernel_gta3xlwifi/00e4b9481434f9b0b644925a9bb2feaf3940219d/firmware/$FVP
FVP_SHA256=3793478b6df52fe760a89cbcfb258a9c489365ee2d13d9dae8df2f161abadb61

if [ "${1:-}" = --fetch ] && [ ! -s "$FW/$FVP" ]; then
	tmp=$(mktemp)
	trap 'rm -f "$tmp"' EXIT
	curl -fsSL "$FVP_URL" -o "$tmp"
	echo "$FVP_SHA256  $tmp" | sha256sum -c --quiet
	install -D -m 644 "$tmp" "$FW/$FVP"
fi

for f in $FVP calliope_sram.bin calliope_dram.bin; do
	# -s follows the links to /vendor
	[ -s "$FW/$f" ] || echo "t510-firmware: no $FW/$f" >&2
done

# ACPM (its clocks drive cpufreq and the GPU) and ABOX wait in the deferred
# probe list; their consumers follow once they bind
for dev in firmware:power-management 14a50000.abox; do
	[ -e "/sys/bus/platform/devices/$dev/driver" ] ||
		echo "$dev" > /sys/bus/platform/drivers_probe 2>/dev/null || true
done

# the display manager needs the GPU render node for glamor
if [ -e /sys/bus/platform/devices/firmware:power-management/driver ]; then
	i=0
	while [ ! -e /dev/dri/renderD128 ] && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
fi

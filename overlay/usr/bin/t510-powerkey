#!/usr/bin/python3
"""Power button for the SM-T510 X session: lock + screen off, or screen on.

A press with the screen off turns it on at once. With the screen on, a short
press (released before LONG_PRESS) locks, turns it off and suspends (s2idle,
when the kernel has it; the key wakes the tablet and the screen comes back
on; a cable plugged in or out wakes it too, and then it goes back to sleep
with the screen off once the charger has set its current); released after a
longer hold it takes a screenshot (t510-screenshot:
Pictures/Screenshots and the clipboard); held for POWER_PRESS it opens the
Xfce power dialog (log out, restart, shut down) while still held. When the
session is locked the screenshot and the dialog would both land behind the
greeter, so they are skipped: the greeter has its own power menu.

Reads KEY_POWER from the gpio-keys evdev node ("gpio_keys" on 4.4), readable by
the seat user via the uaccess udev rule, and drives X DPMS and, on mainline, the
panel backlight (bl_power, group-writable by 70-t510-backlight.rules). logind
ignores the key.
"""
import glob
import os
import select
import struct
import subprocess
import time

EV_KEY = 0x01
KEY_POWER = 116
LONG_PRESS = 0.8  # seconds: screenshot instead of lock
POWER_PRESS = 3.0  # seconds: power dialog
CHARGER_SETTLE = 3.0  # seconds: BC1.2 ends (attach) a moment after VBUS
CHARGER_ONLINE = "/sys/class/power_supply/s2mu005-charger/online"

children = []


def spawn(cmd):
    """Start cmd in the background and reap the ones that have exited."""
    children[:] = [p for p in children if p.poll() is None]
    children.append(subprocess.Popen(cmd, start_new_session=True))


def find_device():
    for path in glob.glob("/sys/class/input/input*"):
        try:
            with open(path + "/name") as f:
                if f.read().strip() not in ("gpio_keys", "gpio-keys"):
                    continue
        except OSError:
            continue
        for ev in glob.glob(path + "/event*"):
            return "/dev/input/" + os.path.basename(ev)
    return None


def backlight_power():
    """bl_power of the panel backlight (mainline), None without one (4.4)."""
    for path in glob.glob("/sys/class/backlight/*/bl_power"):
        return path
    return None


def monitor_on():
    bl = backlight_power()
    if bl:
        # the backlight is the truth: X DPMS cannot blank simplefb
        with open(bl) as f:
            return f.read().strip() == "0"
    out = subprocess.run(["xset", "q"], capture_output=True, text=True).stdout
    return "Monitor is Off" not in out


def set_backlight(on):
    bl = backlight_power()
    if bl:
        try:
            with open(bl, "w") as f:
                f.write("0" if on else "4")
        except OSError:
            pass


def locked():
    out = subprocess.run(["light-locker-command", "-q"],
                         capture_output=True, text=True).stdout
    return "is active" in out


def can_suspend():
    # s2idle needs a kernel with CONFIG_SUSPEND (t510-kernel 7.3.0+67 on)
    try:
        with open("/sys/power/state") as f:
            return "freeze" in f.read().split()
    except OSError:
        return False


def slept():
    """Seconds spent suspended since boot: BOOTTIME runs on, MONOTONIC stops."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def charger_online():
    """Whether a cable is in, as the charger reads it now; None without one."""
    try:
        with open(CHARGER_ONLINE) as f:
            return f.read().strip()
    except OSError:
        return None


def loginctl_value(*args):
    return subprocess.run(["loginctl", "show-" + args[0], *args[1:], "--value"],
                          capture_output=True, text=True).stdout.strip()


def greeter_shown():
    """Whether the seat shows LightDM's greeter: the lock is up.

    This session goes inactive as soon as light-locker switches the VT; on
    the first lock the greeter's X server, its session and then the greeter
    itself start one after the other, seconds in all."""
    seat = os.environ.get("XDG_SEAT", "seat0")
    sid = loginctl_value("seat", seat, "-p", "ActiveSession")
    if not sid or loginctl_value("session", sid, "-p", "Class") != "greeter":
        return False
    return subprocess.run(["pgrep", "-u", "lightdm", "-f", "^lightdm-gtk-greeter"],
                          capture_output=True).returncode == 0


def keep_dark(seconds):
    """Keep the backlight off for a while: an X server that turns the display
    on (the greeter's, starting or getting the VT back) turns it on too, as
    exynos7885-decon enables it with the CRTC."""
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if monitor_on():
            set_backlight(False)
        time.sleep(0.05)


def lock_and_off():
    # light-locker hands the screen to the LightDM greeter (password and
        # on-screen keyboard as at login); xflock4 if it is not running
        if subprocess.run(["light-locker-command", "-l"]).returncode != 0:
            subprocess.run(["xflock4"])
        time.sleep(0.5)
        subprocess.run(["xset", "dpms", "force", "off"])
        set_backlight(False)
        # the first lock starts the greeter (seconds): keep the screen dark
        # until it is up, and sleep only then, or it only comes up after the
        # wakeup
        if not greeter_shown():
            deadline = time.monotonic() + 10
            while not greeter_shown() and time.monotonic() < deadline:
                keep_dark(0.2)
            # a greeter that has just started: time to draw its window
            keep_dark(1)
        set_backlight(False)
        if can_suspend():
            subprocess.run(["systemctl", "suspend"])


def screen_on():
    set_backlight(True)
    subprocess.run(["xset", "dpms", "force", "on"])


def screenshot():
    if not locked():
        # stays running while it holds the clipboard
        spawn(["t510-screenshot"])


def power_dialog():
    if not locked():
        spawn(["xfce4-session-logout"])


def main():
    while True:
        dev = find_device()
        if not dev:
            time.sleep(5)
            continue
        try:
            fd = os.open(dev, os.O_RDONLY)
        except OSError:
            time.sleep(2)
            continue
        # pressed: time of a press whose action is still to be decided
        pressed = None
        # asleep: slept() when a short press suspended, until the wakeup
        asleep = None
        # wake_press: the next press is the one that woke the tablet
        wake_press = False
        # cable: charger_online() when it went to sleep
        cable = None
        try:
            while True:
                timeout = None
                if pressed is not None:
                    timeout = max(0, pressed + POWER_PRESS - time.monotonic())
                if asleep is not None:
                    timeout = 1 if timeout is None else min(timeout, 1)
                ready = select.select([fd], [], [], timeout)[0]
                woke = asleep is not None and slept() - asleep > 0.5
                if woke:
                    # back from suspend: gpio-keys reports the press that
                    # woke it, the next press below
                    asleep = None
                    wake_press = True
                if pressed is not None and time.monotonic() >= pressed + POWER_PRESS:
                    pressed = None
                    power_dialog()
                if not ready:
                    if woke:
                        wake_press = False
                        if cable is not None and charger_online() != cable:
                            # a cable plugged in or out woke it (the PMIC is a
                            # wakeup source): the charger sets the current for
                            # it, then back to sleep, unless the key is pressed
                            # meanwhile (read in the next round)
                            if not select.select([fd], [], [], CHARGER_SETTLE)[0]:
                                cable = charger_online()
                                asleep = slept()
                                subprocess.run(["systemctl", "suspend"])
                        else:
                            # woken by something else: no press to turn it on
                            screen_on()
                    continue
                data = os.read(fd, 24 * 16)
                if not data:
                    break
                for off in range(0, len(data) - 23, 24):
                    _, _, typ, code, value = struct.unpack_from("qqHHi", data, off)
                    if typ != EV_KEY or code != KEY_POWER:
                        continue
                    if value == 1:
                        if wake_press:
                            # the press that woke the tablet (gpio-keys
                            # reports it): only the screen comes on
                            wake_press = False
                            screen_on()
                        elif monitor_on():
                            pressed = time.monotonic()
                        else:
                            asleep = None
                            screen_on()
                    elif value == 0 and pressed is not None:
                        held = time.monotonic() - pressed
                        pressed = None
                        if held < LONG_PRESS:
                            asleep = slept()
                            cable = charger_online()
                            lock_and_off()
                        else:
                            screenshot()
        except OSError:
            time.sleep(2)
        finally:
            os.close(fd)


if __name__ == "__main__":
    main()

#!/bin/sh
# LightDM display/session setup. Under fbdev, X re-initialises the panel on
# start and decon then needs a pan to scan out the framebuffer again. Under
# KMS a pan would replace the KMS buffer with the fbdev memory, so do nothing.
# Mainline simplefb scans out the S-Boot buffer all the time: nothing to do.

# t510-rotate restarts LightDM with a one-shot autologin into the same user;
# LightDM has read its configuration by now, so drop it for the next start.
rm -f /etc/lightdm/lightdm.conf.d/60-t510-rotate-autologin.conf

[ "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" = simple ] && exit 0
[ -e /dev/dri/card0 ] && [ ! -e /etc/X11/t510/force-fbdev ] || exec /usr/local/bin/fbtool unblank
exit 0

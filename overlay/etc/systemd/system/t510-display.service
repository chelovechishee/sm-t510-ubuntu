[Unit]
Description=Wake the panel and show the framebuffer console
DefaultDependencies=no
After=systemd-udevd.service
Before=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
# mainline simplefb shows the S-Boot buffer by itself
ExecCondition=/bin/sh -c '[ "$(cat /sys/class/graphics/fb0/name)" != simple ]'
ExecStart=/usr/local/bin/fbtool unblank

[Install]
WantedBy=sysinit.target

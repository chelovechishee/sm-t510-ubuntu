#!/bin/busybox sh
# SM-T510 mainline, phase 0: report what works, touch nothing, stay on screen.
# Output goes to /dev/kmsg: the screen (fbcon) and the ramoops console both
# take it from there; once the downstream kernel is back (Download mode), it
# shows the ramoops console as /sys/fs/pstore/pmsg-ramoops-0.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
exec >/dev/kmsg 2>&1

say() { echo "T510: $*"; }

say "=== mainline phase 0: $(uname -r) ==="
# eMMC enumerates ~0.3 s after init starts
for i in $(seq 1 100); do [ -b /dev/mmcblk0p33 ] && break; sleep 0.1; done
say "cmdline: $(cat /proc/cmdline)"
say "cpus online: $(cat /sys/devices/system/cpu/online)"
say "mem: $(grep MemTotal /proc/meminfo)"
say "partitions: $(grep -c mmcblk0p /proc/partitions)"
for d in /sys/bus/platform/devices/*; do
	[ -e "$d/driver" ] || continue
	echo "${d##*/}=$(basename "$(readlink "$d/driver")")"
done | tr '\n' ' ' | sed 's/^/T510: bound: /'
echo
say "input: $(sed -n 's/^N: Name=//p' /proc/bus/input/devices | tr '\n' ' ')"

mkdir -p /mnt
if [ -b /dev/mmcblk0p33 ] && mount -t ext4 -o ro,noload /dev/mmcblk0p33 /mnt; then
	say "userdata ro: $(sed -n 's/^PRETTY_NAME=//p' /mnt/etc/os-release)"
	umount /mnt
else
	say "userdata: mount FAILED"
fi

say "=== phase 0 done: photo the screen, then Download mode ==="
while :; do sleep 3600; done

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 37/41] arm64: dts: gta3xlwifi: S2MU005 interrupt pin without
 the pull-down

The S2MU005 INT output is open drain with a pull-up on the board. The
bootloader leaves gpa2-2 with the SoC's pull-down on, which holds the
line low: with the wakeup EINT delivered, the level-low interrupt fired
some 300 times a second with every status register empty. Configure the
pin as the vendor device tree does (EINT, no pull).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
index 1a98cf704..de4135933 100644
--- a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
@@ -381,6 +381,8 @@ pmic@3d {
 		reg = <0x3d>;
 		interrupt-parent = <&gpa2>;
 		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&if_pmic_irq>;
 		monitored-battery = <&battery>;
 		/*
 		 * A cable plugged in or out during sleep wakes the tablet, so the
@@ -598,6 +600,14 @@ key_power: key-power-pins {
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
 	};
+
+	/* open drain, pulled up on the board: the bootloader's pull-down holds it low */
+	if_pmic_irq: if-pmic-irq-pins {
+		samsung,pins = "gpa2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
 };
 
 &pmu_system_controller {

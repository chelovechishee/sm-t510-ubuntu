From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 20/41] ASoC: tfa989x: add TFA9896

Revision 0x96 with the init sequence of the downstream tfa98xx driver
(boost, current sense), as used on the Galaxy Tab A 10.1 (2019).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 sound/soc/codecs/tfa989x.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/sound/soc/codecs/tfa989x.c b/sound/soc/codecs/tfa989x.c
index 7204be155..83777ad9f 100644
--- a/sound/soc/codecs/tfa989x.c
+++ b/sound/soc/codecs/tfa989x.c
@@ -49,6 +49,7 @@
 
 #define TFA9890_REVISION		0x80
 #define TFA9895_REVISION		0x12
+#define TFA9896_REVISION		0x96
 #define TFA9897_REVISION		0x97
 
 struct tfa989x_rev {
@@ -241,6 +242,34 @@ static const struct tfa989x_rev tfa9895_rev = {
 	.init	= tfa9895_init,
 };
 
+/* TFA9896 "v17" register defaults from the NXP driver (tfa9896_specific) */
+static const struct reg_sequence tfa9896_reg_init[] = {
+	{ TFA989X_AUDIO_CTR, 0x000b },
+	{ TFA989X_DCDCBOOST, 0x3e7f },
+	{ 0x0a, 0x0d8a },
+	/* reduce slewrate by clearing iddqtestbst to avoid booster damage */
+	{ TFA989X_CURRENTSENSE3, 0x0300 },
+	{ 0x88, 0x0100 },
+};
+
+static int tfa9896_init(struct regmap *regmap)
+{
+	int ret;
+
+	ret = regmap_multi_reg_write(regmap, tfa9896_reg_init,
+				     ARRAY_SIZE(tfa9896_reg_init));
+	if (ret)
+		return ret;
+
+	/* Enable clipping */
+	return regmap_clear_bits(regmap, TFA989X_CURRENTSENSE4, 0x1);
+}
+
+static const struct tfa989x_rev tfa9896_rev = {
+	.rev	= TFA9896_REVISION,
+	.init	= tfa9896_init,
+};
+
 static int tfa9897_init(struct regmap *regmap)
 {
 	int ret;
@@ -406,6 +435,7 @@ static int tfa989x_i2c_probe(struct i2c_client *i2c)
 static const struct of_device_id tfa989x_of_match[] = {
 	{ .compatible = "nxp,tfa9890", .data = &tfa9890_rev },
 	{ .compatible = "nxp,tfa9895", .data = &tfa9895_rev },
+	{ .compatible = "nxp,tfa9896", .data = &tfa9896_rev },
 	{ .compatible = "nxp,tfa9897", .data = &tfa9897_rev },
 	{ }
 };

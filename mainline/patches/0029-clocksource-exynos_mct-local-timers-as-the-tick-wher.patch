From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 29/53] clocksource: exynos_mct: local timers as the tick where
 the arch timer stops

On Exynos 7885 the arch timer stops when cpuidle powers a core down. The MCT
local timers live in the always-on domain and their interrupts wake the
core, which is how the vendor kernel ran its tick. A new DT property
samsung,local-timers-tick rates them above the arch timer, so no broadcast
is needed. On arm64 the 64-bit arch counter stays the sched_clock.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clocksource/exynos_mct.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/clocksource/exynos_mct.c b/drivers/clocksource/exynos_mct.c
index da09f467a..be3d6e0d2 100644
--- a/drivers/clocksource/exynos_mct.c
+++ b/drivers/clocksource/exynos_mct.c
@@ -77,6 +77,7 @@ enum {
 static void __iomem *reg_base;
 static unsigned long clk_rate;
 static unsigned int mct_int_type;
+static int mct_tick_rating = MCT_CLKEVENTS_RATING;
 static int mct_irqs[MCT_NR_IRQS];
 
 struct mct_clock_event_device {
@@ -255,7 +256,9 @@ static int __init exynos4_clocksource_init(bool frc_shared)
 	if (clocksource_register_hz(&mct_frc, clk_rate))
 		panic("%s: can't register clocksource\n", mct_frc.name);
 
-	sched_clock_register(exynos4_read_sched_clock, 32, clk_rate);
+	/* the 64-bit arch counter is the better sched_clock on arm64 */
+	if (IS_ENABLED(CONFIG_ARM))
+		sched_clock_register(exynos4_read_sched_clock, 32, clk_rate);
 
 	return 0;
 }
@@ -470,7 +473,7 @@ static int exynos4_mct_starting_cpu(unsigned int cpu)
 	evt->tick_resume = set_state_shutdown;
 	evt->features = CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT |
 			CLOCK_EVT_FEAT_PERCPU;
-	evt->rating = MCT_CLKEVENTS_RATING;
+	evt->rating = mct_tick_rating;
 
 	exynos4_mct_write(TICK_BASE_CNT, mevt->base + MCT_L_TCNTB_OFFSET);
 
@@ -664,6 +667,13 @@ static int __init mct_init_dt(struct device_node *np, unsigned int int_type)
 			local_idx[i] = i;
 	}
 
+	/*
+	 * Where the arch timer stops in cpuidle core power down, the local
+	 * timers (always on) are the better per-CPU tick: no broadcast needed.
+	 */
+	if (of_property_read_bool(np, "samsung,local-timers-tick"))
+		mct_tick_rating = 500;
+
 	ret = exynos4_timer_resources(np);
 	if (ret)
 		return ret;
-- 
2.53.0


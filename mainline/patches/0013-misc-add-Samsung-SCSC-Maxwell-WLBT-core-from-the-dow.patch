diff --git a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
index b942511af..0f7b25ef4 100644
--- a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
@@ -97,6 +97,7 @@ seclog@c0000000 {
 		};
 
 		wifibt@e9000000 {
+			compatible = "exynos,wifibt_if";
 			reg = <0x0 0xe9000000 0x400000>;
 			no-map;
 		};
@@ -143,6 +144,17 @@ backlight@14870000 {
 		reg = <0x0 0x14870000 0x100>;
 	};
 
+	/* Maxwell WLBT (Wi-Fi/BT) core: mailboxes for the AP and the M4 */
+	wlbt@120c0000 {
+		compatible = "samsung,scsc_wifibt";
+		reg = <0x0 0x120c0000 0x180>, <0x0 0x120e0000 0x180>;
+		interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 286 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "MBOX", "ALIVE", "WDOG";
+		samsung,syscon-phandle = <&pmu_system_controller>;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 		pinctrl-names = "default";

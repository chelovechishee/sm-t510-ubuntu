+static char *chip_version(u32 rf_hw_ver)
+{
+	switch (rf_hw_ver & 0x00ff) {
+	default:
+		break;
+	case 0x00b0:
+		if ((rf_hw_ver & 0xff00) > 0x1000)
+			return "S610/S611";
+		else
+			return "S610";
+	case 0x00b1:
+		return "S612";
+	case 0x00b2:
+		return "S620";
+	case 0x0000:
+#ifndef CONFIG_SOC_EXYNOS9610
+		return "Error: check if RF chip is present";
+#else
+		return "Unknown";
+#endif
+	}
+	return "Unknown";
+}

+ *
+ ******************************************************************************/
+#ifndef _SCSC_WIFILOGGER_INTERNAL_H_
+#define _SCSC_WIFILOGGER_INTERNAL_H_
+
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/bitops.h>
+

+/* mainline has no printk_emit(); the format may not be a literal */
+static inline __printf(2, 3) void scsc_printk_lvl(int lvl, const char *fmt, ...)
+{
+	va_list args;
+
+	va_start(args, fmt);
+	vprintk_emit(0, lvl, NULL, fmt, args);
+	va_end(args);
+}

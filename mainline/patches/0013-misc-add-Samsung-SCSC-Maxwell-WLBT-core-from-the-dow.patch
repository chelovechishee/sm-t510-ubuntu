+static void failure_wq_start(struct mxman *mxman)
+{
+	if (disable_error_handling)
+		SCSC_TAG_INFO(MXMAN, "error handling disabled\n");
+	else
+		queue_work(mxman->failure_wq, &mxman->failure_work);
+}

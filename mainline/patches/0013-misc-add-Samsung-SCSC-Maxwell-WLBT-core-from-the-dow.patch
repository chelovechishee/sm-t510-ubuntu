diff --git a/drivers/misc/samsung/scsc/scsc_compat.c b/drivers/misc/samsung/scsc/scsc_compat.c
new file mode 100644
index 000000000..0a4fe1d90
--- /dev/null
+++ b/drivers/misc/samsung/scsc/scsc_compat.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Downstream kernel interfaces used by the SCSC platform code, on mainline:
+ * the PMU through its syscon regmap, and the "shared external regulator"
+ * request (on the Wi-Fi-only SM-T510 there is no CP to negotiate it with, so
+ * only the PMU option bit is kept).
+ */
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+#include <linux/spinlock.h>
+#include <soc/samsung/exynos-pmu.h>
+
+#define EXT_REGULATOR_SHARED_OPTION	0x3648
+
+static struct regmap *scsc_pmu_regmap(void)
+{
+	static struct regmap *map;
+
+	if (IS_ERR_OR_NULL(map))
+		map = syscon_regmap_lookup_by_compatible("samsung,exynos7885-pmu");
+	return map;
+}
+
+int exynos_pmu_read(unsigned int offset, unsigned int *val)
+{
+	struct regmap *map = scsc_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_read(map, offset, val);
+}
+
+int exynos_pmu_write(unsigned int offset, unsigned int val)
+{
+	struct regmap *map = scsc_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_write(map, offset, val);
+}
+
+int exynos_pmu_update(unsigned int offset, unsigned int mask, unsigned int val)
+{
+	struct regmap *map = scsc_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_update_bits(map, offset, mask, val);
+}
+
+static DEFINE_SPINLOCK(shared_reg_lock);
+static int shared_reg_users;
+
+int exynos_pmu_shared_reg_enable(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&shared_reg_lock, flags);
+	if (!shared_reg_users++)
+		exynos_pmu_update(EXT_REGULATOR_SHARED_OPTION, 0x4, 0x4);
+	spin_unlock_irqrestore(&shared_reg_lock, flags);
+	return 0;
+}
+
+void exynos_pmu_shared_reg_disable(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&shared_reg_lock, flags);
+	if (shared_reg_users && !--shared_reg_users)
+		exynos_pmu_update(EXT_REGULATOR_SHARED_OPTION, 0x4, 0x0);
+	spin_unlock_irqrestore(&shared_reg_lock, flags);
+}

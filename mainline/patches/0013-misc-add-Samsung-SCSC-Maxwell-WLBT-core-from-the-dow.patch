+	SCSC_TAG_INFO_DEV(PLAT_MIF, platform->dev, "Unregistering mif int handler %pS\n", interface);
+	spin_lock_irqsave(&platform->mif_spinlock, flags);
+	platform->r4_handler = platform_mif_irq_default_handler;

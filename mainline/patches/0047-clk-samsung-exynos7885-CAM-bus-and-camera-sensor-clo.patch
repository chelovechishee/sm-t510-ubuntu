+#define CLK_DOUT_CAM_BUS		65
+#define CLK_MOUT_CIS_CLK0		66
+#define CLK_MOUT_CIS_CLK1		67
+#define CLK_MOUT_CIS_CLK2		68
+#define CLK_GOUT_CIS_CLK0		69
+#define CLK_GOUT_CIS_CLK1		70
+#define CLK_GOUT_CIS_CLK2		71
+#define CLK_DOUT_CIS_CLK0		72
+#define CLK_DOUT_CIS_CLK1		73
+#define CLK_DOUT_CIS_CLK2		74
 
 /* CMU_CORE */
 #define CLK_MOUT_CORE_BUS_USER			1
-- 

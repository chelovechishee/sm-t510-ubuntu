From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 31/43] arm64: dts: gta3xlwifi: enable i2c_1 (S2MU005
 charger/MUIC at 0x3d)

The charger is configured from userspace over i2c-dev for now.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
index fa63c4475..40be269eb 100644
--- a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
@@ -368,6 +368,11 @@ fuel-gauge@3b {
 	};
 };
 
+/* S2MU005 charger/MUIC/flash at 0x3d */
+&i2c_1 {
+	status = "okay";
+};
+
 &usi2 {
 	samsung,mode = <USI_MODE_I2C1>;
 	status = "okay";
-- 

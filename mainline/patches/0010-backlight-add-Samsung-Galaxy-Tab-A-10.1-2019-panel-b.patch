diff --git a/drivers/video/backlight/gta3xl_bl.c b/drivers/video/backlight/gta3xl_bl.c
new file mode 100644
index 000000000..574592a68
--- /dev/null
+++ b/drivers/video/backlight/gta3xl_bl.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Backlight of the Samsung Galaxy Tab A 10.1 (2019) panel (Himax HX8279D)
+ *
+ * The panel dims its own LED driver: DCS write 0xB8 after selecting register
+ * page 4 (0xB0 0x04). There is no DSI host driver for Exynos 7885 in mainline;
+ * the bootloader leaves DSIM running in video mode, so the two short packets
+ * are queued straight into its packet header FIFO and go out in blanking.
+ *
+ * Brightness table: for each level the lower of the two panel revisions'
+ * tables in the Samsung driver (full scale is 156, as on Android; 199 is only
+ * used there for outdoor mode and is not reachable here).
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+#define DSIM_PKTHDR			0x58
+#define DSIM_FIFOCTRL			0x68
+#define DSIM_FIFOCTRL_FULL_PH_SFR	BIT(11)
+#define DSIM_FIFOCTRL_EMPTY_PH_SFR	BIT(10)
+#define DSIM_CMD_CONFIG			0x80
+#define DSIM_CMD_CONFIG_PKT_GO_EN	BIT(16)
+
+#define MIPI_DSI_DCS_SHORT_WRITE_PARAM	0x15
+
+#define HX8279D_PAGE_SELECT		0xb0
+#define HX8279D_PAGE_BACKLIGHT		0x04
+#define HX8279D_BRIGHTNESS		0xb8
+
+#define GTA3XL_BL_MAX			255
+#define GTA3XL_BL_DEFAULT		117
+
+static const u8 gta3xl_bl_table[GTA3XL_BL_MAX + 1] = {
+	0, 0, 1, 1, 2, 2, 3, 4, 4, 5, 6, 6, 7, 7, 8, 9,
+	9, 10, 11, 11, 12, 13, 13, 14, 14, 15, 16, 16, 17, 18, 18, 19,
+	20, 20, 21, 21, 22, 23, 23, 24, 25, 25, 26, 27, 27, 28, 28, 29,
+	30, 30, 31, 32, 32, 33, 34, 34, 35, 35, 36, 37, 37, 38, 39, 39,
+	40, 40, 41, 42, 42, 43, 44, 44, 45, 46, 46, 47, 47, 48, 49, 49,
+	50, 51, 51, 52, 53, 53, 54, 54, 55, 56, 56, 57, 58, 58, 59, 60,
+	60, 61, 61, 62, 63, 63, 64, 65, 65, 66, 67, 67, 68, 68, 69, 70,
+	70, 71, 72, 72, 73, 74, 74, 75, 75, 76, 76, 77, 78, 78, 79, 79,
+	80, 81, 81, 82, 82, 83, 84, 84, 85, 85, 86, 87, 87, 88, 88, 89,
+	90, 90, 91, 91, 92, 93, 93, 94, 94, 95, 95, 96, 97, 97, 98, 98,
+	99, 100, 100, 101, 101, 102, 103, 103, 104, 104, 105, 106, 106, 107, 107, 108,
+	109, 109, 110, 110, 111, 112, 112, 113, 113, 114, 115, 115, 116, 116, 117, 117,
+	118, 119, 119, 120, 120, 121, 122, 122, 123, 123, 124, 125, 125, 126, 126, 127,
+	128, 128, 129, 129, 130, 131, 131, 132, 132, 133, 134, 134, 135, 135, 136, 136,
+	137, 138, 138, 139, 139, 140, 141, 141, 142, 142, 143, 144, 144, 145, 145, 146,
+	147, 147, 148, 148, 149, 150, 150, 151, 151, 152, 153, 153, 154, 154, 155, 156,
+};
+
+struct gta3xl_bl {
+	struct device *dev;
+	void __iomem *dsim;
+	struct mutex lock;
+};
+
+static int gta3xl_bl_dcs_write(struct gta3xl_bl *bl, u8 cmd, u8 param)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(bl->dsim + DSIM_FIFOCTRL, val,
+				 !(val & DSIM_FIFOCTRL_FULL_PH_SFR), 100, 50000);
+	if (ret)
+		return ret;
+
+	val = readl(bl->dsim + DSIM_CMD_CONFIG);
+	writel(val | DSIM_CMD_CONFIG_PKT_GO_EN, bl->dsim + DSIM_CMD_CONFIG);
+	writel(MIPI_DSI_DCS_SHORT_WRITE_PARAM | cmd << 8 | param << 16,
+	       bl->dsim + DSIM_PKTHDR);
+	writel(val & ~DSIM_CMD_CONFIG_PKT_GO_EN, bl->dsim + DSIM_CMD_CONFIG);
+
+	return readl_poll_timeout(bl->dsim + DSIM_FIFOCTRL, val,
+				  val & DSIM_FIFOCTRL_EMPTY_PH_SFR, 100, 50000);
+}
+
+static int gta3xl_bl_update_status(struct backlight_device *bd)
+{
+	struct gta3xl_bl *bl = bl_get_data(bd);
+	int level = backlight_get_brightness(bd);
+	int ret;
+
+	mutex_lock(&bl->lock);
+	ret = gta3xl_bl_dcs_write(bl, HX8279D_PAGE_SELECT, HX8279D_PAGE_BACKLIGHT);
+	if (!ret)
+		ret = gta3xl_bl_dcs_write(bl, HX8279D_BRIGHTNESS,
+					  gta3xl_bl_table[level]);
+	mutex_unlock(&bl->lock);
+
+	if (ret)
+		dev_err(bl->dev, "failed to set brightness %d: %d\n", level, ret);
+	return ret;
+}
+
+static const struct backlight_ops gta3xl_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = gta3xl_bl_update_status,
+};
+
+static int gta3xl_bl_probe(struct platform_device *pdev)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = GTA3XL_BL_MAX,
+		.brightness = GTA3XL_BL_DEFAULT,
+		.scale = BACKLIGHT_SCALE_NON_LINEAR,
+	};
+	struct backlight_device *bd;
+	struct gta3xl_bl *bl;
+	int ret;
+
+	bl = devm_kzalloc(&pdev->dev, sizeof(*bl), GFP_KERNEL);
+	if (!bl)
+		return -ENOMEM;
+	bl->dev = &pdev->dev;
+
+	ret = devm_mutex_init(&pdev->dev, &bl->lock);
+	if (ret)
+		return ret;
+
+	/* DSIM is owned by nobody in mainline: map it without claiming it */
+	bl->dsim = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(bl->dsim))
+		return PTR_ERR(bl->dsim);
+
+	bd = devm_backlight_device_register(&pdev->dev, "panel", &pdev->dev,
+					    bl, &gta3xl_bl_ops, &props);
+	if (IS_ERR(bd))
+		return PTR_ERR(bd);
+
+	return backlight_update_status(bd);
+}
+
+static const struct of_device_id gta3xl_bl_of_match[] = {
+	{ .compatible = "samsung,gta3xlwifi-backlight" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gta3xl_bl_of_match);
+
+static struct platform_driver gta3xl_bl_driver = {
+	.probe = gta3xl_bl_probe,
+	.driver = {
+		.name = "gta3xl-backlight",
+		.of_match_table = gta3xl_bl_of_match,
+	},
+};
+module_platform_driver(gta3xl_bl_driver);
+
+MODULE_DESCRIPTION("Samsung Galaxy Tab A 10.1 (2019) panel backlight");
+MODULE_LICENSE("GPL");
-- 

diff --git a/drivers/input/touchscreen/stm-fts1ba90a.c b/drivers/input/touchscreen/stm-fts1ba90a.c
new file mode 100644
index 000000000..66555c8d1
--- /dev/null
+++ b/drivers/input/touchscreen/stm-fts1ba90a.c
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * STMicroelectronics FTS1BA90A touchscreen
+ * (Samsung Galaxy Tab A 10.1 2019, SM-T510)
+ *
+ * The controller speaks a newer FTS protocol than the one handled by stmfts:
+ * commands and the 8-byte event format follow Samsung's downstream fts_ts
+ * driver. Firmware lives in the controller's flash and is not updated here.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#define FTS_READ_DEVICE_ID		0x22
+#define FTS_CMD_SET_GET_TOUCHTYPE	0x30
+#define FTS_READ_ONE_EVENT		0x60
+#define FTS_READ_ALL_EVENT		0x61
+#define FTS_CMD_CLEAR_ALL_EVENT		0x62
+#define FTS_CMD_SET_SCANMODE		0xa0
+#define FTS_CMD_IC_INTERRUPT		0xa4
+#define FTS_CMD_SYSTEM_RESET		0xfa
+
+#define FTS_ID0				0x39
+#define FTS_ID1				0x36
+
+#define FTS_TOUCHTYPE_TOUCH		BIT(0)
+#define FTS_TOUCHTYPE_PALM		BIT(5)
+#define FTS_TOUCHTYPE_WET		BIT(6)
+#define FTS_SCAN_MODE_MS_SS		BIT(0)
+
+#define FTS_EVENT_SIZE			8
+#define FTS_FIFO_MAX			32
+#define FTS_MAX_FINGERS			10
+
+/* event byte 0 */
+#define FTS_EV_ID			GENMASK(1, 0)
+#define FTS_EV_ID_COORDINATE		0
+#define FTS_EV_ID_STATUS		1
+#define FTS_EV_TOUCH_ID			GENMASK(5, 2)
+#define FTS_EV_ACTION			GENMASK(7, 6)
+#define FTS_ACTION_PRESS		1
+#define FTS_ACTION_MOVE			2
+#define FTS_ACTION_RELEASE		3
+/* status event */
+#define FTS_EV_STATUS_TYPE		GENMASK(5, 2)
+#define FTS_STATUS_TYPE_INFO		2
+#define FTS_INFO_READY			0x00
+#define FTS_EVENT_STATUS_REPORT		0x43
+#define FTS_EVENT_ERROR_REPORT		0xf3
+/* coordinate event: byte 6 bits 7:6 and byte 7 bits 7:6 form the touch type */
+#define FTS_TTYPE_PALM			5
+#define FTS_EV_LEFT			GENMASK(5, 0)
+
+struct fts1ba90a {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+	struct regulator_bulk_data supplies[2];
+	u8 data[FTS_FIFO_MAX * FTS_EVENT_SIZE];
+};
+
+static int fts_write(struct fts1ba90a *ts, const u8 *buf, int len)
+{
+	int ret = i2c_master_send(ts->client, buf, len);
+
+	return ret == len ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int fts_read(struct fts1ba90a *ts, u8 cmd, u8 *buf, int len)
+{
+	struct i2c_msg msg[] = {
+		{ .addr = ts->client->addr, .len = 1, .buf = &cmd },
+		{ .addr = ts->client->addr, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int ret = i2c_transfer(ts->client->adapter, msg, ARRAY_SIZE(msg));
+
+	return ret == ARRAY_SIZE(msg) ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+/* Poll the event queue until the controller echoes @cmd (or says READY). */
+static int fts_wait_event(struct fts1ba90a *ts, const u8 *cmd, int len)
+{
+	u8 ev[FTS_EVENT_SIZE];
+	int i, ret;
+
+	for (i = 0; i < 50; i++) {
+		ret = fts_read(ts, FTS_READ_ONE_EVENT, ev, sizeof(ev));
+		if (ret)
+			return ret;
+
+		if (!cmd) {
+			if (FIELD_GET(FTS_EV_ID, ev[0]) == FTS_EV_ID_STATUS &&
+			    FIELD_GET(FTS_EV_STATUS_TYPE, ev[0]) == FTS_STATUS_TYPE_INFO &&
+			    ev[1] == FTS_INFO_READY)
+				return 0;
+		} else if (ev[0] == FTS_EVENT_STATUS_REPORT && ev[1] == 0x01 &&
+			   !memcmp(&ev[2], cmd, min(len, 6))) {
+			return 0;
+		}
+
+		if (ev[0] == FTS_EVENT_ERROR_REPORT)
+			dev_warn(&ts->client->dev, "error event %*ph\n",
+				 FTS_EVENT_SIZE, ev);
+		msleep(20);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int fts_command(struct fts1ba90a *ts, const u8 *cmd, int len, bool echo)
+{
+	int ret = fts_write(ts, cmd, len);
+
+	if (ret || !echo)
+		return ret;
+	return fts_wait_event(ts, cmd, len);
+}
+
+static int fts_hw_init(struct fts1ba90a *ts)
+{
+	static const u8 reset[] = { FTS_CMD_SYSTEM_RESET, 0x20, 0x00, 0x00, 0x24, 0x81 };
+	static const u8 touchtype[] = { FTS_CMD_SET_GET_TOUCHTYPE,
+		FTS_TOUCHTYPE_TOUCH | FTS_TOUCHTYPE_PALM | FTS_TOUCHTYPE_WET, 0x00 };
+	static const u8 clear[] = { FTS_CMD_CLEAR_ALL_EVENT };
+	static const u8 scan[] = { FTS_CMD_SET_SCANMODE, 0x00, FTS_SCAN_MODE_MS_SS };
+	static const u8 irq_on[] = { FTS_CMD_IC_INTERRUPT, 0x01, 0x01 };
+	struct device *dev = &ts->client->dev;
+	u8 id[5];
+	int ret;
+
+	ret = fts_write(ts, reset, sizeof(reset));
+	if (ret)
+		return dev_err_probe(dev, ret, "system reset failed\n");
+	msleep(10);
+
+	ret = fts_wait_event(ts, NULL, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "controller not ready\n");
+
+	ret = fts_read(ts, FTS_READ_DEVICE_ID, id, sizeof(id));
+	if (ret)
+		return ret;
+	if (id[2] != FTS_ID0 || id[3] != FTS_ID1)
+		return dev_err_probe(dev, -ENODEV, "unexpected chip id %*ph\n",
+				     (int)sizeof(id), id);
+	dev_info(dev, "FTS %02x%02x, id %02x\n", id[2], id[3], id[4]);
+
+	ret = fts_command(ts, touchtype, sizeof(touchtype), false);
+	if (ret)
+		return ret;
+	msleep(10);
+
+	ret = fts_command(ts, clear, sizeof(clear), true);
+	if (ret)
+		dev_warn(dev, "no echo for clear events: %d\n", ret);
+
+	ret = fts_command(ts, scan, sizeof(scan), true);
+	if (ret)
+		return dev_err_probe(dev, ret, "enabling scan failed\n");
+
+	ret = fts_command(ts, irq_on, sizeof(irq_on), false);
+	if (ret)
+		return ret;
+	msleep(10);
+
+	return 0;
+}
+
+static void fts_report(struct fts1ba90a *ts, const u8 *ev)
+{
+	unsigned int id = FIELD_GET(FTS_EV_TOUCH_ID, ev[0]);
+	unsigned int action = FIELD_GET(FTS_EV_ACTION, ev[0]);
+	unsigned int x = (ev[1] << 4) | (ev[3] >> 4);
+	unsigned int y = (ev[2] << 4) | (ev[3] & 0x0f);
+	unsigned int ttype = ((ev[6] >> 6) << 2) | (ev[7] >> 6);
+	unsigned int z = ev[6] & 0x3f;
+
+	if (id >= FTS_MAX_FINGERS)
+		return;
+
+	input_mt_slot(ts->input, id);
+	if (action == FTS_ACTION_RELEASE) {
+		input_mt_report_slot_inactive(ts->input);
+		return;
+	}
+	if (action != FTS_ACTION_PRESS && action != FTS_ACTION_MOVE)
+		return;
+
+	input_mt_report_slot_state(ts->input,
+				   ttype == FTS_TTYPE_PALM ? MT_TOOL_PALM : MT_TOOL_FINGER,
+				   true);
+	touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+	input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, ev[4]);
+	input_report_abs(ts->input, ABS_MT_TOUCH_MINOR, ev[5]);
+	input_report_abs(ts->input, ABS_MT_PRESSURE, z ?: 1);
+}
+
+static irqreturn_t fts_irq(int irq, void *dev_id)
+{
+	struct fts1ba90a *ts = dev_id;
+	int left, i;
+
+	if (fts_read(ts, FTS_READ_ONE_EVENT, ts->data, FTS_EVENT_SIZE))
+		return IRQ_NONE;
+
+	left = min_t(int, FIELD_GET(FTS_EV_LEFT, ts->data[7]), FTS_FIFO_MAX - 1);
+	if (left && fts_read(ts, FTS_READ_ALL_EVENT, ts->data + FTS_EVENT_SIZE,
+			     left * FTS_EVENT_SIZE))
+		left = 0;
+
+	for (i = 0; i <= left; i++) {
+		const u8 *ev = ts->data + i * FTS_EVENT_SIZE;
+
+		if (FIELD_GET(FTS_EV_ID, ev[0]) == FTS_EV_ID_COORDINATE)
+			fts_report(ts, ev);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+
+	return IRQ_HANDLED;
+}
+
+static void fts_power_off(void *data)
+{
+	struct fts1ba90a *ts = data;
+
+	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+}
+
+static int fts_power_on(struct fts1ba90a *ts)
+{
+	int ret;
+
+	/* avdd first, then dvdd, as in the downstream driver */
+	ret = regulator_enable(ts->supplies[0].consumer);
+	if (ret)
+		return ret;
+	usleep_range(1000, 2000);
+	ret = regulator_enable(ts->supplies[1].consumer);
+	if (ret) {
+		regulator_disable(ts->supplies[0].consumer);
+		return ret;
+	}
+	msleep(5);
+
+	return 0;
+}
+
+static int fts_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct fts1ba90a *ts;
+	int ret;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+
+	ts->supplies[0].supply = "avdd";
+	ts->supplies[1].supply = "vdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ts->supplies), ts->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = fts_power_on(ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+	ret = devm_add_action_or_reset(dev, fts_power_off, ts);
+	if (ret)
+		return ret;
+
+	ret = fts_hw_init(ts);
+	if (ret)
+		return ret;
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+	ts->input->name = "STM FTS1BA90A Touchscreen";
+	ts->input->id.bustype = BUS_I2C;
+
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, 4095, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, 4095, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MINOR, 0, 255, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 63, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+
+	ret = input_mt_init_slots(ts->input, FTS_MAX_FINGERS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+
+	return devm_request_threaded_irq(dev, client->irq, NULL, fts_irq,
+					 IRQF_ONESHOT, "fts1ba90a", ts);
+}
+
+static const struct of_device_id fts_of_match[] = {
+	{ .compatible = "st,fts1ba90a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fts_of_match);
+
+static const struct i2c_device_id fts_id[] = {
+	{ "fts1ba90a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, fts_id);
+
+static struct i2c_driver fts_driver = {
+	.driver = {
+		.name = "fts1ba90a",
+		.of_match_table = fts_of_match,
+	},
+	.probe = fts_probe,
+	.id_table = fts_id,
+};
+module_i2c_driver(fts_driver);
+
+MODULE_DESCRIPTION("STMicroelectronics FTS1BA90A touchscreen driver");
+MODULE_LICENSE("GPL");
-- 

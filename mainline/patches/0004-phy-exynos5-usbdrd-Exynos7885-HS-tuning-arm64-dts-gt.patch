From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 04/52] phy: exynos5-usbdrd: Exynos7885 HS tuning; arm64: dts:
 gta3xlwifi: UTMI 8-bit, GFLADJ

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos7904-gta3xlwifi.dts |  5 ++++
 drivers/phy/samsung/phy-exynos5-usbdrd.c      | 26 +++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
index ddcbf1ae6..de1dd91f2 100644
--- a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
@@ -156,6 +156,11 @@ &usbdrd {
 &usbdrd_dwc3 {
 	/* VBUS and role come from the S2MM005 CCIC, not supported yet */
 	dr_mode = "peripheral";
+	/* GUSB2PHYCFG (8-bit UTMI+, no PHY suspend) and GFLADJ as in the downstream kernel */
+	phy_type = "utmi";
+	snps,quirk-frame-length-adjustment = <0x20>;
+	snps,dis_u2_susphy_quirk;
+	snps,dis_enblslpm_quirk;
 };
 
 &usbdrd_phy {
diff --git a/drivers/phy/samsung/phy-exynos5-usbdrd.c b/drivers/phy/samsung/phy-exynos5-usbdrd.c
index 9aed922ad..fdb6103a1 100644
--- a/drivers/phy/samsung/phy-exynos5-usbdrd.c
+++ b/drivers/phy/samsung/phy-exynos5-usbdrd.c
@@ -2079,8 +2079,34 @@ static const struct exynos5_usbdrd_phy_drvdata exynos850_usbdrd_phy = {
 	.n_regulators		= ARRAY_SIZE(exynos5_regulator_names),
 };
 
+/* HS PHY tuning of the downstream kernel (SM-T510, device mode) */
+static const struct exynos5_usbdrd_phy_tuning exynos7885_tunes_utmi_postinit[] = {
+	PHY_TUNING_ENTRY_PHY(EXYNOS850_DRD_HSPPARACON,
+			     (HSPPARACON_TXVREF | HSPPARACON_TXRISE |
+			      HSPPARACON_TXRES | HSPPARACON_TXPREEMPPULSE |
+			      HSPPARACON_TXPREEMPAMP | HSPPARACON_TXHSXV |
+			      HSPPARACON_TXFSLS | HSPPARACON_SQRX |
+			      HSPPARACON_OTG | HSPPARACON_COMPDIS),
+			     (FIELD_PREP_CONST(HSPPARACON_TXVREF, 13) |
+			      FIELD_PREP_CONST(HSPPARACON_TXRISE, 3) |
+			      FIELD_PREP_CONST(HSPPARACON_TXRES, 3) |
+			      FIELD_PREP_CONST(HSPPARACON_TXPREEMPPULSE, 0) |
+			      FIELD_PREP_CONST(HSPPARACON_TXPREEMPAMP, 3) |
+			      FIELD_PREP_CONST(HSPPARACON_TXHSXV, 3) |
+			      FIELD_PREP_CONST(HSPPARACON_TXFSLS, 3) |
+			      FIELD_PREP_CONST(HSPPARACON_SQRX, 7) |
+			      FIELD_PREP_CONST(HSPPARACON_OTG, 2) |
+			      FIELD_PREP_CONST(HSPPARACON_COMPDIS, 7))),
+	PHY_TUNING_ENTRY_LAST
+};
+
+static const struct exynos5_usbdrd_phy_tuning *exynos7885_tunes[PTS_MAX] = {
+	[PTS_UTMI_POSTINIT] = exynos7885_tunes_utmi_postinit,
+};
+
 static const struct exynos5_usbdrd_phy_drvdata exynos7885_usbdrd_phy = {
 	.phy_cfg		= phy_cfg_exynos850,
+	.phy_tunes		= exynos7885_tunes,
 	.phy_ops		= &exynos850_usbdrd_phy_ops,
 	.pmu_offset_usbdrd0_phy	= EXYNOS7885_USBDRD_PHY_CONTROL,
 	.clk_names		= exynos5_clk_names,
-- 
2.53.0


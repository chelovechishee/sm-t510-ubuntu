+{
+	exynos_smc(0x82000701, 0, 0, 0);
+	pr_err("%s: ABOX_CA7 security changed!!!\n", __func__);
+}
+static DECLARE_DELAYED_WORK(work_temp, work_temp_function);
+#endif

+/**
+ * Generate interrupt
+ * @param[in]	pdev	pointer to platform_device of abox_gic device
+ * @param[in]	hw_irq	hardware irq number
+ */
+extern void abox_gic_generate_interrupt(struct platform_device *pdev,
+		int hw_irq);
+
+/**

+/**
+ * test quirk bitmap
+ * @param[in]	quirks		quirk bitmap
+ * @param[in]	quirk		quirk to test
+ * @return	true if quirk is in quirks, false on otherwise.
+ */
+static inline bool abox_test_quirk(unsigned long quirks, unsigned long quirk)
+{
+	return !!(quirks & quirk);
+}

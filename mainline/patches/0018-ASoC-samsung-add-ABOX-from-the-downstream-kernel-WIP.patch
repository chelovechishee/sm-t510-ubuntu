+/* SPDX-License-Identifier: GPL-2.0 */
+/* Downstream exynos_pmu_* on the mainline PMU syscon */
+#ifndef _ABOX_COMPAT_EXYNOS_PMU_H
+#define _ABOX_COMPAT_EXYNOS_PMU_H
+#include <linux/err.h>
+#include <linux/regmap.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+
+static inline int exynos_pmu_read(unsigned int offset, unsigned int *val)
+{
+	struct regmap *map = exynos_get_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_read(map, offset, val);
+}
+
+static inline int exynos_pmu_write(unsigned int offset, unsigned int val)
+{
+	struct regmap *map = exynos_get_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_write(map, offset, val);
+}
+
+static inline int exynos_pmu_update(unsigned int offset, unsigned int mask,
+				    unsigned int val)
+{
+	struct regmap *map = exynos_get_pmu_regmap();
+
+	return IS_ERR(map) ? PTR_ERR(map) : regmap_update_bits(map, offset, mask, val);
+}
+#endif

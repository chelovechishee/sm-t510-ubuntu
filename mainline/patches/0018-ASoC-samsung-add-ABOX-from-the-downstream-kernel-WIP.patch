+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Parts of the downstream ABOX driver left out of the mainline port: the PCM
+ * dump interface (debug captures of internal streams) is not built.
+ */
+#include <linux/device.h>
+#include "abox_dump.h"
+
+void abox_dump_period_elapsed(int id, size_t pointer)
+{
+}
+
+int abox_dump_register_buffer(struct device *dev, int id, const char *name,
+			      void *area, phys_addr_t addr, size_t bytes)
+{
+	return 0;
+}
+
+#include <sound/soc.h>
+#include <sound/soc-dapm.h>
+#include "abox_compat_dapm.h"
+
+/*
+ * snd_soc_dapm_connected_{input,output}_ep() collected every widget on the
+ * connected paths from @start; they are private to soc-dapm.c now. Walk the
+ * connected paths towards the sources (DIR_IN) or the sinks (DIR_OUT) and
+ * queue each widget once on @list through its work_list. Called with the
+ * DAPM mutex held, after the caller re-initialised every work_list (a widget
+ * already queued, by this or an earlier call, is not visited again).
+ */
+void abox_dapm_collect(struct snd_soc_dapm_widget *start,
+		       enum snd_soc_dapm_direction dir, struct list_head *list)
+{
+	struct snd_soc_dapm_widget *w, *next;
+	struct snd_soc_dapm_path *p;
+	LIST_HEAD(queue);
+
+	if (!start)
+		return;
+
+	list_add_tail(&start->work_list, &queue);
+	while (!list_empty(&queue)) {
+		w = list_first_entry(&queue, struct snd_soc_dapm_widget, work_list);
+		list_move_tail(&w->work_list, list);
+		snd_soc_dapm_widget_for_each_path(w, dir, p) {
+			if (!p->connect)
+				continue;
+			next = p->node[dir];
+			if (list_empty(&next->work_list) && next != start)
+				list_add_tail(&next->work_list, &queue);
+		}
+	}
+}
+
+/* Bluetooth audio over the SCSC WLBT core is not ported: no BT SCO stream */
+#include <scsc/api/bt_audio.h>
+
+int scsc_bt_audio_register(struct scsc_bt_audio_driver *driver)
+{
+	return 0;
+}
diff --git a/sound/soc/samsung/abox/abox_compat.h b/sound/soc/samsung/abox/abox_compat.h
new file mode 100644
index 000000000..9897bc858
--- /dev/null
+++ b/sound/soc/samsung/abox/abox_compat.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Forced include for the ABOX driver: kernel interfaces of the 4.4 vendor
+ * kernel that mainline renamed or dropped. Vendor headers live in compat/.
+ */
+#pragma once
+#include <linux/version.h>
+#include <linux/iommu.h>
+#include <linux/fs.h>
+#include <linux/sched/clock.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#include <linux/dma-mapping.h>
+
+/* no set_fs() any more: kernel buffers go through kernel_write() */
+typedef int mm_segment_t;
+#define KERNEL_DS		0
+#define get_fs()		0
+#define set_fs(x)		do { (void)(x); } while (0)
+#define vfs_write(file, buf, count, pos) kernel_write(file, buf, count, pos)
+
+/* the prot argument was dropped: vm_map_ram() always maps PAGE_KERNEL */
+#define vm_map_ram(pages, count, node, prot) vm_map_ram(pages, count, node)
+
+/* every use copies "sizeof(dst) - 1" bytes into a zeroed buffer */
+#define strncpy(dst, src, n)	strscpy_pad(dst, src, (n) + 1)
+
+#define dma_mmap_writecombine	dma_mmap_wc
+
+/* 4.4 iommu_map() had no gfp argument and the SysMMU ignored prot */
+#define iommu_map(domain, iova, paddr, size, prot) \
+	iommu_map(domain, iova, paddr, size, (prot) | IOMMU_READ | IOMMU_WRITE, GFP_KERNEL)
+
+#include <linux/pinctrl/consumer.h>
+#include <sound/soc-dapm.h>
+#include "compat/linux/smc.h"	/* mainline <linux/smc.h> is the SMC network protocol */
+
+/* no PM QoS classes for INT/MIF/AUD/clusters on mainline: requests are dropped */
+#define PM_QOS_AUD_THROUGHPUT		0
+#define PM_QOS_BUS_THROUGHPUT		0
+#define PM_QOS_CLUSTER0_FREQ_MIN	0
+#define PM_QOS_CLUSTER1_FREQ_MIN	0
+#define PM_QOS_DEVICE_THROUGHPUT	0
+#define pm_qos_add_request(req, cls, val)	do { } while (0)
+#define pm_qos_update_request(req, val)		do { } while (0)
+#define pm_qos_remove_request(req)		do { } while (0)
+#define pm_qos_request(cls)			0
+#define set_hmp_boost(on)			do { } while (0)
+
+/* no FM radio (S610) */
+#define exynos_get_fm_open_status()		0
+
+/* 4.4 had an event-capable demux */
+#define SND_SOC_DAPM_DEMUX_E(wname, wreg, wshift, winvert, wcontrols, wevent, wflags) \
+{	.id = snd_soc_dapm_demux, .name = wname, \
+	SND_SOC_DAPM_INIT_REG_VAL(wreg, wshift, winvert), \
+	.kcontrol_news = wcontrols, .num_kcontrols = 1, \
+	.event = wevent, .event_flags = wflags }
+
+#include <linux/panic_notifier.h>
+/* component controls carry the component as chip data */
+#define snd_soc_kcontrol_component(kcontrol) \
+	((struct snd_soc_component *)snd_kcontrol_chip(kcontrol))

+	/*
+	 * ABOX audio subsystem (Cortex-A7 DSP "calliope", RDMA/WDMA, mixer and
+	 * the UAIF serial ports). The DSP sees memory through its own SysMMU.
+	 */
+	sysmmu_abox: sysmmu@14a30000 {
+		compatible = "samsung,exynos-sysmmu";
+		reg = <0x0 0x14a30000 0x9000>;
+		interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cmu_dispaud CLK_GOUT_SMMU_ABOX_CLK>;
+		clock-names = "sysmmu";
+		#iommu-cells = <0>;
+	};
+
+	abox_gic: abox-gic@14af0000 {
+		compatible = "samsung,abox_gic";
+		reg = <0x0 0x14af1000 0x1000>, <0x0 0x14af2000 0x1004>;
+		reg-names = "gicd", "gicc";
+		interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	abox: abox@14a50000 {
+		compatible = "samsung,abox";
+		reg = <0x0 0x14a50000 0x10000>, <0x0 0x14820000 0x10000>,
+		      <0x0 0x14b00000 0x28000>;
+		reg-names = "sfr", "sysreg", "sram";
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+		pinctrl-names = "default", "idle";
+		pinctrl-0 = <&aud_codec_mclk &aud_codec_bus &aud_spk_bus &aud_loopback_bus>;
+		pinctrl-1 = <&aud_codec_mclk_idle &aud_codec_bus_idle &aud_spk_bus_idle
+			     &aud_loopback_bus_idle>;
+		ipc_tx_offset = <0x22000>;
+		ipc_rx_offset = <0x22300>;
+		ipc_tx_ack_offset = <0x222fc>;
+		ipc_rx_ack_offset = <0x225fc>;
+		mailbox_offset = <0x22600>;
+		abox_gic = <&abox_gic>;
+		clocks = <&cmu_dispaud CLK_FOUT_AUD_PLL>, <&cmu_dispaud CLK_GOUT_ABOX_CCLK_CA7>,
+			 <&cmu_dispaud CLK_DOUT_AUD_AUDIF>, <&cmu_dispaud CLK_DOUT_AUD_UAIF0>,
+			 <&cmu_dispaud CLK_DOUT_AUD_UAIF2>, <&cmu_dispaud CLK_DOUT_AUD_UAIF3>,
+			 <&cmu_dispaud CLK_GOUT_ABOX_BCLK_UAIF0>,
+			 <&cmu_dispaud CLK_GOUT_ABOX_BCLK_UAIF2>,
+			 <&cmu_dispaud CLK_GOUT_ABOX_BCLK_UAIF3>;
+		clock-names = "pll", "ca7", "audif", "bclk0", "bclk2", "bclk3",
+			      "bclk0_gate", "bclk2_gate", "bclk3_gate";
+		iommus = <&sysmmu_abox>;
+		pm_qos_int = <533000 333000 0 0 0>;
+		pm_qos_aud = <1180000 800000 590000 394000 0>;
+		samsung,abox-bootargs = "init=ab0x vss=0";
+		samsung,abox-bootargs-offset = <0x22e00>;
+
+		abox_rdma_0: abox-rdma@14a51000 {
+			compatible = "samsung,abox-rdma";
+			reg = <0x0 0x14a51000 0x100>;

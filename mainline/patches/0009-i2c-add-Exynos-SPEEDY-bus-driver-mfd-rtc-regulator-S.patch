+#define S2MPU08_REG_B5CTRL2		0x1d
+#define S2MPU08_REG_B6CTRL1		0x1e
+#define S2MPU08_REG_B6CTRL2		0x1f
+#define S2MPU08_REG_B7CTRL1		0x20
+#define S2MPU08_REG_B7CTRL2		0x21
+#define S2MPU08_REG_B8CTRL1		0x23
+#define S2MPU08_REG_B8CTRL2		0x24
+#define S2MPU08_REG_BUCKRAMP		0x28
+
+#define S2MPU08_REG_L1CTRL		0x2c
+#define S2MPU08_REG_L2CTRL1		0x2d
+#define S2MPU08_REG_L2CTRL2		0x2e
+/* LDO3..LDO37 control registers follow one per LDO from 0x2f */
+#define S2MPU08_REG_LCTRL(n)		(0x2c + (n))
+
+/* S2MPU08 regulator ids (LDO15..LDO32 are not bonded out) */
+enum s2mpu08_regulators {
+	S2MPU08_LDO1,

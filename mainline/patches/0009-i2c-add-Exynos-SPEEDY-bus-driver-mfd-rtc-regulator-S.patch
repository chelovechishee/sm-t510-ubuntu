+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Samsung S2MPU08 PMIC (Exynos 7885/7904, behind the SPEEDY bus)
+ *
+ * Register map of the PMIC block (SPEEDY device 1), from the Samsung
+ * downstream kernel.
+ */
+
+#ifndef __LINUX_MFD_S2MPU08_H
+#define __LINUX_MFD_S2MPU08_H
+
+#define S2MPU08_REG_INT1		0x00
+#define S2MPU08_REG_INT2		0x01
+#define S2MPU08_REG_INT3		0x02
+#define S2MPU08_REG_INT1M		0x03
+#define S2MPU08_REG_INT2M		0x04
+#define S2MPU08_REG_INT3M		0x05
+#define S2MPU08_REG_STATUS1		0x06
+#define S2MPU08_REG_STATUS2		0x07
+#define S2MPU08_REG_PWRONSRC		0x08
+#define S2MPU08_REG_OFFSRC		0x09
+#define S2MPU08_REG_CTRL1		0x0c
+#define S2MPU08_REG_CTRL2		0x0d
+#define S2MPU08_REG_CTRL3		0x0e
+
+#define S2MPU08_REG_B1CTRL1		0x14
+#define S2MPU08_REG_B1CTRL2		0x15
+#define S2MPU08_REG_B2CTRL1		0x16
+#define S2MPU08_REG_B2CTRL2		0x17
+#define S2MPU08_REG_B3CTRL1		0x18
+#define S2MPU08_REG_B3CTRL2		0x19
+#define S2MPU08_REG_B4CTRL1		0x1a
+#define S2MPU08_REG_B4CTRL2		0x1b

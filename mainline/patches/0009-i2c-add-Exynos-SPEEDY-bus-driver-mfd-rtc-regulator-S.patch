diff --git a/drivers/i2c/busses/i2c-exynos-speedy.c b/drivers/i2c/busses/i2c-exynos-speedy.c
new file mode 100644
index 000000000..6e9f4f75e
--- /dev/null
+++ b/drivers/i2c/busses/i2c-exynos-speedy.c
@@ -0,0 +1,472 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Exynos SPEEDY (Serial Protocol in an EffEctive Digital waY) master
+ *
+ * SPEEDY is a one-wire bus to the PMIC (and the audio codec inside it) on
+ * Exynos 7885/7904 and similar SoCs. The ACPM firmware on the APM core uses
+ * the same bus, so every transfer goes through the IP batcher: the AP writes a
+ * list of register writes into the batcher, the batcher takes the shared
+ * hardware semaphore, replays the list and releases the semaphore.
+ *
+ * A SPEEDY address is 12 bits: device id (bits 11:8) and register (7:0).
+ * Clients are I2C devices at the device id; the usual "write register number,
+ * then read" pair of messages becomes a single SPEEDY read, and a write of
+ * "register, data..." a single SPEEDY write, so regmap-i2c works unchanged.
+ *
+ * Based on the Samsung downstream driver by Youngmin Nam.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define SPEEDY_CTRL			0x000
+#define SPEEDY_FIFO_CTRL		0x004
+#define SPEEDY_CMD			0x008
+#define SPEEDY_INT_ENABLE		0x00c
+#define SPEEDY_INT_STATUS		0x010
+#define SPEEDY_TX_DATA			0x034
+#define SPEEDY_RX_DATA			0x038
+
+/* SPEEDY_CTRL; 0x30050 is the reset value */
+#define SPEEDY_CTRL_RESET_VALUE		0x30050
+#define SPEEDY_ENABLE			BIT(0)
+#define SPEEDY_REMOTE_RESET_REQ		BIT(30)
+#define SPEEDY_SW_RST			BIT(31)
+
+#define SPEEDY_RX_TRIGGER_LEVEL(x)	((x) << 0)
+#define SPEEDY_TX_TRIGGER_LEVEL(x)	((x) << 8)
+#define SPEEDY_FIFO_RESET		BIT(31)
+
+#define SPEEDY_BURST_LENGTH(x)		((x) << 0)
+#define SPEEDY_BURST_INCR		(1 << 5)
+#define SPEEDY_ADDRESS(x)		(((x) & 0xfff) << 7)
+#define SPEEDY_ACCESS_RANDOM		BIT(19)
+#define SPEEDY_DIRECTION_WRITE		BIT(20)
+
+/* SPEEDY_INT_ENABLE / SPEEDY_INT_STATUS */
+#define SPEEDY_TRANSFER_DONE		BIT(0)
+#define SPEEDY_TIMEOUT_CMD		BIT(1)
+#define SPEEDY_TIMEOUT_STANDBY		BIT(2)
+#define SPEEDY_TIMEOUT_DATA		BIT(3)
+#define SPEEDY_FIFO_TX_ALMOST_EMPTY	BIT(4)
+#define SPEEDY_FIFO_RX_ALMOST_FULL	BIT(8)
+#define SPEEDY_RX_FIFO_INT_TRAILER	BIT(9)
+#define SPEEDY_RX_MODEBIT_ERR		BIT(16)
+#define SPEEDY_RX_GLITCH_ERR		BIT(17)
+#define SPEEDY_RX_ENDBIT_ERR		BIT(18)
+#define SPEEDY_TX_LINE_BUSY_ERR		BIT(20)
+#define SPEEDY_TX_STOPBIT_ERR		BIT(21)
+#define SPEEDY_TIMEOUTS			(SPEEDY_TIMEOUT_CMD | SPEEDY_TIMEOUT_STANDBY | \
+					 SPEEDY_TIMEOUT_DATA)
+#define SPEEDY_ERRORS			(SPEEDY_TIMEOUTS | SPEEDY_RX_MODEBIT_ERR | \
+					 SPEEDY_RX_GLITCH_ERR | SPEEDY_RX_ENDBIT_ERR | \
+					 SPEEDY_TX_LINE_BUSY_ERR | SPEEDY_TX_STOPBIT_ERR)
+
+#define SPEEDY_FIFO_EMPTY		BIT(6)
+
+/* IP batcher */
+#define IPBATCHER_SEMA_REL		0x0200
+#define IPBATCHER_CON			0x0500
+#define IPBATCHER_STATE			0x0504
+#define IPBATCHER_INT_EN		0x0508
+#define IPBATCHER_FSM_UNEXPEN		0x050c
+#define IPBATCHER_FSM_TXEN		0x0510
+#define IPBATCHER_FSM_RXFIFO		0x0514
+#define IPBATCHER_FSM_CON		0x0518
+#define IP_INT_STATUS			0x0520
+#define BATCHER_OPCODE			0x0600
+#define BATCHER_PAYLOAD			0x1000
+#define BATCHER_PAYLOAD_SLOTS		25
+
+#define BATCHER_ENABLE			BIT(0)
+#define DEDICATED_BATCHER_APB		BIT(1)
+#define START_BATCHER			BIT(4)
+#define IP_SW_RST			BIT(6)
+#define MP_APBSEMA_SW_RST		BIT(7)
+#define BATCHER_SW_RESET		BIT(31)
+
+#define BATCHER_OPERATION_COMPLETE	BIT(0)
+#define UNEXPECTED_IP_INTR		BIT(1)
+#define BATCHER_FSM_STATE_IDLE		BIT(3)
+#define BATCHER_FSM_STATE_INIT		BIT(4)
+#define BATCHER_FSM_STATE_WAIT_INT	BIT(7)
+#define MP_APBSEMA_CH_LOCK_STATUS	BIT(20)
+
+#define BATCHER_INTERRUPT_ENABLE	BIT(0)
+#define DISABLE_STOP_CMD		BIT(0)
+
+#define BATCHER_INIT_CMD		0xffffffff
+#define BATCHER_OPCODE_END		0xff
+
+#define SPEEDY_TIMEOUT_US		500000
+/* payload slots left for data after the per-transfer setup */
+#define SPEEDY_MAX_BURST		16
+#define SPEEDY_SRP_COUNT		3
+
+struct exynos_speedy {
+	struct device *dev;
+	struct i2c_adapter adap;
+	void __iomem *regs;
+	/* batcher program being built */
+	u32 cmd_buffer;
+	unsigned int cmd_index;
+	unsigned int cmd_pointer;
+	unsigned int desc_pointer;
+	u32 int_en;
+};
+
+static void batcher_reset_program(struct exynos_speedy *speedy)
+{
+	speedy->cmd_buffer = BATCHER_INIT_CMD;
+	speedy->cmd_index = 0;
+	speedy->cmd_pointer = 0;
+	speedy->desc_pointer = 0;
+}
+
+/* Queue "write @value to SPEEDY register @reg" into the batcher program. */
+static void batcher_write(struct exynos_speedy *speedy, u32 value, u8 reg)
+{
+	if (WARN_ON(speedy->desc_pointer >= BATCHER_PAYLOAD_SLOTS))
+		return;
+
+	speedy->cmd_buffer &= ~(0xff << (8 * speedy->cmd_index));
+	speedy->cmd_buffer |= reg << (8 * speedy->cmd_index);
+	writel(speedy->cmd_buffer,
+	       speedy->regs + BATCHER_OPCODE + speedy->cmd_pointer * 4);
+	writel(value, speedy->regs + BATCHER_PAYLOAD + speedy->desc_pointer * 4);
+	speedy->desc_pointer++;
+
+	if (++speedy->cmd_index == 4) {
+		speedy->cmd_index = 0;
+		speedy->cmd_pointer++;
+		speedy->cmd_buffer = BATCHER_INIT_CMD;
+	}
+}
+
+static void batcher_con_set(struct exynos_speedy *speedy, u32 bits)
+{
+	writel(readl(speedy->regs + IPBATCHER_CON) | bits,
+	       speedy->regs + IPBATCHER_CON);
+}
+
+static void batcher_con_pulse(struct exynos_speedy *speedy, u32 bits)
+{
+	u32 con = readl(speedy->regs + IPBATCHER_CON);
+
+	writel(con | bits, speedy->regs + IPBATCHER_CON);
+	writel(con & ~bits, speedy->regs + IPBATCHER_CON);
+}
+
+static void batcher_program_fsm(struct exynos_speedy *speedy)
+{
+	/* IP interrupts handled as errors, as Tx events and as Rx FIFO status */
+	writel(SPEEDY_ERRORS, speedy->regs + IPBATCHER_FSM_UNEXPEN);
+	writel(SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_TX_ALMOST_EMPTY,
+	       speedy->regs + IPBATCHER_FSM_TXEN);
+	writel(SPEEDY_FIFO_EMPTY, speedy->regs + IPBATCHER_FSM_RXFIFO);
+	writel(DISABLE_STOP_CMD, speedy->regs + IPBATCHER_FSM_CON);
+}
+
+static int batcher_wait_ready(struct exynos_speedy *speedy)
+{
+	u32 state;
+
+	return readl_poll_timeout_atomic(speedy->regs + IPBATCHER_STATE, state,
+					 state & (BATCHER_FSM_STATE_IDLE |
+						  BATCHER_FSM_STATE_INIT),
+					 10, SPEEDY_TIMEOUT_US);
+}
+
+/* Recover the IP and the batcher after a failed transfer. */
+static void speedy_swreset(struct exynos_speedy *speedy)
+{
+	u32 state = readl(speedy->regs + IPBATCHER_STATE);
+
+	if (state & MP_APBSEMA_CH_LOCK_STATUS) {
+		if (state & BATCHER_FSM_STATE_WAIT_INT)
+			batcher_con_set(speedy, IP_SW_RST);
+		else
+			writel(readl(speedy->regs + SPEEDY_CTRL) | SPEEDY_SW_RST,
+			       speedy->regs + SPEEDY_CTRL);
+		udelay(110);
+
+		state = readl(speedy->regs + IPBATCHER_STATE);
+		if (!(state & BATCHER_FSM_STATE_INIT)) {
+			batcher_con_pulse(speedy, MP_APBSEMA_SW_RST);
+			udelay(100);
+			batcher_con_pulse(speedy, BATCHER_SW_RESET);
+			batcher_program_fsm(speedy);
+			if (batcher_wait_ready(speedy))
+				dev_err(speedy->dev, "batcher stuck after reset\n");
+		}
+		writel(0x01, speedy->regs + IPBATCHER_SEMA_REL);
+	} else {
+		batcher_con_pulse(speedy, BATCHER_SW_RESET);
+		batcher_program_fsm(speedy);
+	}
+
+	if (batcher_wait_ready(speedy))
+		dev_err(speedy->dev, "batcher not idle after reset\n");
+}
+
+static void speedy_queue_cmd(struct exynos_speedy *speedy, bool write,
+			     u16 address, unsigned int len)
+{
+	u32 fifo_ctl = SPEEDY_FIFO_RESET;
+	u32 int_en = SPEEDY_TIMEOUTS;
+	u32 cmd = SPEEDY_ADDRESS(address);
+
+	if (len > 1) {
+		cmd |= SPEEDY_BURST_INCR | SPEEDY_BURST_LENGTH(len - 1);
+		fifo_ctl |= SPEEDY_RX_TRIGGER_LEVEL(len) | SPEEDY_TX_TRIGGER_LEVEL(1);
+	} else {
+		cmd |= SPEEDY_ACCESS_RANDOM;
+		fifo_ctl |= SPEEDY_RX_TRIGGER_LEVEL(1) | SPEEDY_TX_TRIGGER_LEVEL(1);
+	}
+	batcher_write(speedy, fifo_ctl, SPEEDY_FIFO_CTRL);
+
+	if (write) {
+		cmd |= SPEEDY_DIRECTION_WRITE;
+		int_en |= SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_TX_ALMOST_EMPTY |
+			  SPEEDY_TX_LINE_BUSY_ERR | SPEEDY_TX_STOPBIT_ERR;
+	} else {
+		int_en |= SPEEDY_FIFO_RX_ALMOST_FULL | SPEEDY_RX_FIFO_INT_TRAILER |
+			  SPEEDY_RX_MODEBIT_ERR | SPEEDY_RX_GLITCH_ERR |
+			  SPEEDY_RX_ENDBIT_ERR;
+	}
+	speedy->int_en = int_en;
+
+	batcher_write(speedy, 0xffffffff, SPEEDY_INT_STATUS);
+	batcher_write(speedy, int_en, SPEEDY_INT_ENABLE);
+	batcher_write(speedy, cmd, SPEEDY_CMD);
+}
+
+static int batcher_run(struct exynos_speedy *speedy)
+{
+	u32 state, status;
+	int ret;
+
+	batcher_write(speedy, 0x00, BATCHER_OPCODE_END);
+	writel(BATCHER_INTERRUPT_ENABLE, speedy->regs + IPBATCHER_INT_EN);
+	batcher_con_set(speedy, START_BATCHER);
+
+	ret = readl_poll_timeout_atomic(speedy->regs + IPBATCHER_STATE, state,
+			(state & BATCHER_OPERATION_COMPLETE) ||
+			((state & UNEXPECTED_IP_INTR) &&
+			 (readl(speedy->regs + IP_INT_STATUS) & SPEEDY_ERRORS)),
+			10, SPEEDY_TIMEOUT_US);
+	status = readl(speedy->regs + IP_INT_STATUS);
+	if (!ret && (status & SPEEDY_ERRORS))
+		ret = -EIO;
+
+	if (state & BATCHER_OPERATION_COMPLETE)
+		writel(state | BATCHER_OPERATION_COMPLETE,
+		       speedy->regs + IPBATCHER_STATE);
+	writel(0, speedy->regs + IPBATCHER_INT_EN);
+
+	if (ret)
+		dev_dbg(speedy->dev, "transfer failed: %d, state %#x, status %#x\n",
+			ret, state, status);
+	return ret;
+}
+
+static void batcher_begin(struct exynos_speedy *speedy)
+{
+	batcher_reset_program(speedy);
+	/* IDLE, then IDLE -> INIT */
+	writel(0, speedy->regs + IPBATCHER_CON);
+	batcher_con_set(speedy, BATCHER_ENABLE | DEDICATED_BATCHER_APB);
+}
+
+/* Remote reset of the slaves, after an error (SRP in the downstream driver). */
+static void speedy_remote_reset(struct exynos_speedy *speedy)
+{
+	u32 ctl = SPEEDY_CTRL_RESET_VALUE | SPEEDY_ENABLE;
+	int i;
+
+	for (i = 0; i < SPEEDY_SRP_COUNT; i++) {
+		batcher_begin(speedy);
+		speedy_queue_cmd(speedy, true, 0x0, 1);
+		batcher_write(speedy, ctl | SPEEDY_REMOTE_RESET_REQ, SPEEDY_CTRL);
+		batcher_write(speedy, 0x00, SPEEDY_TX_DATA);
+		batcher_write(speedy, ctl, SPEEDY_CTRL);
+		if (!batcher_run(speedy)) {
+			writel(0, speedy->regs + IPBATCHER_CON);
+			return;
+		}
+		writel(0, speedy->regs + IPBATCHER_CON);
+		speedy_swreset(speedy);
+	}
+	dev_err(speedy->dev, "remote reset failed\n");
+}
+
+static int speedy_transfer(struct exynos_speedy *speedy, bool write,
+			   u16 address, u8 *buf, unsigned int len)
+{
+	unsigned int i, rx_slot;
+	int ret;
+
+	batcher_begin(speedy);
+	batcher_write(speedy, SPEEDY_CTRL_RESET_VALUE | SPEEDY_ENABLE, SPEEDY_CTRL);
+	speedy_queue_cmd(speedy, write, address, len);
+
+	rx_slot = speedy->desc_pointer;
+	if (write) {
+		for (i = 0; i < len; i++)
+			batcher_write(speedy, buf[i], SPEEDY_TX_DATA);
+		/* a pending TX_ALMOST_EMPTY would hold the line */
+		batcher_write(speedy, speedy->int_en & ~SPEEDY_FIFO_TX_ALMOST_EMPTY,
+			      SPEEDY_INT_ENABLE);
+	} else {
+		for (i = 0; i < len; i++)
+			batcher_write(speedy, 0x77, SPEEDY_RX_DATA);
+	}
+
+	ret = batcher_run(speedy);
+	if (!ret && !write)
+		for (i = 0; i < len; i++)
+			buf[i] = readl(speedy->regs + BATCHER_PAYLOAD +
+				       (rx_slot + i) * 4);
+	writel(0, speedy->regs + IPBATCHER_CON);
+
+	if (ret) {
+		speedy_swreset(speedy);
+		speedy_remote_reset(speedy);
+		/* the I2C core retries -EAGAIN adap->retries times */
+		ret = -EAGAIN;
+	}
+	return ret;
+}
+
+static int speedy_xfer_chunked(struct exynos_speedy *speedy, bool write,
+			       u16 addr, u8 reg, u8 *buf, unsigned int len)
+{
+	unsigned int done, n;
+	int ret;
+
+	for (done = 0; done < len; done += n) {
+		n = min_t(unsigned int, len - done, SPEEDY_MAX_BURST);
+		ret = speedy_transfer(speedy, write, (addr << 8) | (u8)(reg + done),
+				      buf + done, n);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int exynos_speedy_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			      int num)
+{
+	struct exynos_speedy *speedy = i2c_get_adapdata(adap);
+	int ret;
+
+	if (msgs[0].addr > 0xf || (msgs[0].flags & I2C_M_RD) || !msgs[0].len)
+		return -EOPNOTSUPP;
+
+	if (num == 2 && msgs[0].len == 1 && (msgs[1].flags & I2C_M_RD) &&
+	    msgs[1].addr == msgs[0].addr)
+		ret = speedy_xfer_chunked(speedy, false, msgs[0].addr,
+					  msgs[0].buf[0], msgs[1].buf, msgs[1].len);
+	else if (num == 1 && msgs[0].len > 1)
+		ret = speedy_xfer_chunked(speedy, true, msgs[0].addr,
+					  msgs[0].buf[0], msgs[0].buf + 1,
+					  msgs[0].len - 1);
+	else
+		return -EOPNOTSUPP;
+
+	return ret ? ret : num;
+}
+
+static u32 exynos_speedy_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C | I2C_FUNC_SMBUS_BYTE_DATA | I2C_FUNC_SMBUS_WORD_DATA |
+	       I2C_FUNC_SMBUS_I2C_BLOCK;
+}
+
+static const struct i2c_algorithm exynos_speedy_algo = {
+	.xfer = exynos_speedy_xfer,
+	.functionality = exynos_speedy_func,
+};
+
+static const struct i2c_adapter_quirks exynos_speedy_quirks = {
+	.flags = I2C_AQ_COMB_WRITE_THEN_READ,
+	.max_comb_1st_msg_len = 1,
+};
+
+static int exynos_speedy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos_speedy *speedy;
+	struct clk *clk;
+
+	speedy = devm_kzalloc(dev, sizeof(*speedy), GFP_KERNEL);
+	if (!speedy)
+		return -ENOMEM;
+	speedy->dev = dev;
+
+	speedy->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(speedy->regs))
+		return PTR_ERR(speedy->regs);
+
+	/* the APM firmware keeps the bus clocked; the gate is optional */
+	clk = devm_clk_get_optional_enabled(dev, NULL);
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get clock\n");
+
+	/* the bootloader may have used the IP directly */
+	writel(0xffffffff, speedy->regs + SPEEDY_INT_STATUS);
+	writel(readl(speedy->regs + SPEEDY_CTRL) | SPEEDY_SW_RST,
+	       speedy->regs + SPEEDY_CTRL);
+	udelay(10);
+	writel(0x01, speedy->regs + IPBATCHER_SEMA_REL);
+	batcher_con_pulse(speedy, BATCHER_SW_RESET);
+	batcher_program_fsm(speedy);
+
+	strscpy(speedy->adap.name, "exynos-speedy", sizeof(speedy->adap.name));
+	speedy->adap.owner = THIS_MODULE;
+	speedy->adap.algo = &exynos_speedy_algo;
+	speedy->adap.quirks = &exynos_speedy_quirks;
+	speedy->adap.retries = 2;
+	speedy->adap.dev.parent = dev;
+	speedy->adap.dev.of_node = dev->of_node;
+	i2c_set_adapdata(&speedy->adap, speedy);
+	platform_set_drvdata(pdev, speedy);
+
+	return devm_i2c_add_adapter(dev, &speedy->adap);
+}
+
+static const struct of_device_id exynos_speedy_of_match[] = {
+	{ .compatible = "samsung,exynos7885-speedy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos_speedy_of_match);
+
+static struct platform_driver exynos_speedy_driver = {
+	.probe = exynos_speedy_probe,
+	.driver = {
+		.name = "exynos-speedy",
+		.of_match_table = exynos_speedy_of_match,
+	},
+};
+
+static int __init exynos_speedy_init(void)
+{
+	return platform_driver_register(&exynos_speedy_driver);
+}
+/* the PMIC behind it supplies the RTC and regulators: register early */
+subsys_initcall(exynos_speedy_init);
+
+static void __exit exynos_speedy_exit(void)
+{
+	platform_driver_unregister(&exynos_speedy_driver);
+}
+module_exit(exynos_speedy_exit);
+
+MODULE_DESCRIPTION("Samsung Exynos SPEEDY bus driver");
+MODULE_LICENSE("GPL");

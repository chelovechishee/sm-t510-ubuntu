--- /dev/null
+++ b/drivers/soc/samsung/exynos7885-pmu.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 7885/7904 PMU: CPU power-down for cpuidle
+ *
+ * The EL3 monitor's PSCI CPU_SUSPEND saves the core's secure state and
+ * executes WFI, but leaves the PMU alone: the core is only power gated when
+ * its CLUSTERx_CPUy_CONFIGURATION local power request is cleared before
+ * (downstream exynos-powermode cpu_disable()). The register must be set again
+ * on wakeup, otherwise the next plain WFI powers the core down without its
+ * context saved.
+ *
+ * S-Boot leaves the A73 and the second A53 cluster with automatic cluster
+ * power down armed: once both cores sleep, the PMU cuts the cluster with its
+ * L2, which nobody cleaned for a core-level PSCI request, and memory gets
+ * corrupted. Keep every cluster powered (downstream cluster_enable()).
+ */
+
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/cpu_pm.h>
+#include <linux/cpumask.h>
+#include <linux/notifier.h>
+#include <linux/smp.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+
+#include <asm/cputype.h>
+#include <asm/smp_plat.h>
+
+#include "exynos-pmu.h"
+
+#define EXYNOS7885_CPU_LOCAL_PWR_CFG	GENMASK(3, 0)
+
+#define EXYNOS7885_CLUSTER_SEQ_OPTION(cl)	(0x2488 + (cl) * 0x20)
+#define EXYNOS7885_CLUSTER_PWRDN_EN		BIT(0)
+#define EXYNOS7885_CLUSTER_KEEP_ON		BIT(4)
+
+/*
+ * MPIDR Aff1 0: Cortex-A73 pair, 1: Cortex-A53 quad (CPUs 0-3, boots),
+ * 2: Cortex-A53 pair; the PMU orders their blocks 0, 2, 1.
+ */
+static const u16 exynos7885_cluster_cfg[] = { 0x2000, 0x2200, 0x2100 };
+
+static u32 exynos7885_cpu_cfg(unsigned int cpu)
+{
+	u64 mpidr = cpu_logical_map(cpu);
+
+	return exynos7885_cluster_cfg[MPIDR_AFFINITY_LEVEL(mpidr, 1)] +
+	       MPIDR_AFFINITY_LEVEL(mpidr, 0) * 0x80;
+}
+
+static void exynos7885_cpu_set_power(unsigned int cpu, bool on)
+{
+	u32 offset = exynos7885_cpu_cfg(cpu);
+	u32 val = pmu_raw_readl(offset) & ~EXYNOS7885_CPU_LOCAL_PWR_CFG;
+
+	if (on)
+		val |= EXYNOS7885_CPU_LOCAL_PWR_CFG;
+	pmu_raw_writel(val, offset);
+}
+
+/* called on the CPU itself with interrupts off; each CPU owns its register */
+static int exynos7885_cpu_pm_notify(struct notifier_block *nb,
+				    unsigned long action, void *v)
+{
+	unsigned int cpu = smp_processor_id();
+
+	switch (action) {
+	case CPU_PM_ENTER:
+		exynos7885_cpu_set_power(cpu, false);
+		break;
+	case CPU_PM_ENTER_FAILED:
+	case CPU_PM_EXIT:
+		exynos7885_cpu_set_power(cpu, true);
+		break;
+	}
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block exynos7885_cpu_pm_nb = {
+	.notifier_call = exynos7885_cpu_pm_notify,
+	/* last on entry: only runs once every other notifier agreed */
+	.priority = INT_MIN,
+};
+
+static void exynos7885_pmu_init(void)
+{
+	unsigned int cl;
+	u32 val;
+
+	for (cl = 0; cl < ARRAY_SIZE(exynos7885_cluster_cfg); cl++) {
+		val = pmu_raw_readl(EXYNOS7885_CLUSTER_SEQ_OPTION(cl));
+		val &= ~EXYNOS7885_CLUSTER_PWRDN_EN;
+		val |= EXYNOS7885_CLUSTER_KEEP_ON;
+		pmu_raw_writel(val, EXYNOS7885_CLUSTER_SEQ_OPTION(cl));
+	}
+
+	cpu_pm_register_notifier(&exynos7885_cpu_pm_nb);
+}
+
+const struct exynos_pmu_data exynos7885_pmu_data = {
+	.pmu_init = exynos7885_pmu_init,
+};

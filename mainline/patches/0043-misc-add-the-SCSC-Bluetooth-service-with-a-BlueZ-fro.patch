+/*
+ * The H4 stream is read and written by the BlueZ glue (scsc_bluez.c) with
+ * kernel buffers only: there is no H4 character device in this port.
+ */
+static inline unsigned long scsc_bt_copy_to(void *dst, const void *src, size_t n)
+{
+	memcpy(dst, src, n);
+	return 0;
+}
+
+static inline unsigned long scsc_bt_copy_from(void *dst, const void *src, size_t n)
+{
+	memcpy(dst, src, n);
+	return 0;

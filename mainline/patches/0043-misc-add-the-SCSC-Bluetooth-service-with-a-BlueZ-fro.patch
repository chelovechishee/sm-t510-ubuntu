@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * BlueZ (hci_dev) front end of the SCSC Bluetooth driver: the BT service
+ * hands over its H4 stream operations once the Maxwell core is there.
+ */
+#ifndef __SCSC_BLUEZ_H
+#define __SCSC_BLUEZ_H
+
+#include <linux/fs.h>
+#include <linux/wait.h>
+
+void slsi_bt_notify_probe(struct device *dev,
+			  const struct file_operations *fs,
+			  atomic_t *error_count,
+			  wait_queue_head_t *read_wait);
+void slsi_bt_notify_remove(void);
+
+#endif /* __SCSC_BLUEZ_H */

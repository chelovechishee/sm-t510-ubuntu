+++ b/drivers/misc/samsung/scsc_bt/scsc_bluez.c
@@ -0,0 +1,287 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * BlueZ front end of the SCSC (Maxwell) Bluetooth driver.
+ *
+ * The BT service (scsc_bt_module.c, scsc_shm.c) speaks H4 through the file
+ * operations that backed Android's /dev/scsc_h4_0. Here they back an hci_dev:
+ * open starts the BT service on the WLBT core, a kthread reads the H4 stream
+ * (one read may hold several packets, and a packet may be split between
+ * reads) and hands whole frames to the HCI core, send writes H4 packets.
+ *
+ * The firmware lives on Android's VENDOR partition, so hci0 is registered
+ * only when userspace says it can be read:
+ *   echo 1 > /sys/module/scsc_bt/parameters/enable
+ * The HCI core powers a new controller on at once, and a failed first power
+ * on would keep it from bluetoothd for good.
+ */
+
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+#include <net/bluetooth/bluetooth.h>
+#include <net/bluetooth/hci_core.h>
+
+#include "scsc_bluez.h"
+
+static void scsc_bluez_work(struct work_struct *work);
+
+static struct scsc_bluez {
+	/* set by the BT service, read by the HCI callbacks */
+	const struct file_operations *fops;
+	atomic_t *error_count;
+	wait_queue_head_t *read_wait;
+	struct device *dev;		/* the Maxwell core, NULL while it is away */
+
+	bool enable;
+	struct work_struct work;	/* registers or removes hdev */
+	struct hci_dev *hdev;
+
+	struct file file;		/* f_flags 0: blocking reads */
+	struct task_struct *rx_thread;
+	bool stopping;
+
+	/* H4 reassembly */
+	struct sk_buff *rx_skb;
+	unsigned int rx_need;		/* bytes left of the header or payload */
+	bool rx_payload;
+	u8 rx_buf[HCI_MAX_FRAME_SIZE + 1];
+} bz = {
+	.work = __WORK_INITIALIZER(bz.work, scsc_bluez_work),
+};
+
+static void scsc_bluez_recv(struct hci_dev *hdev, const u8 *data, size_t count)
+{
+	struct sk_buff *skb;
+	size_t n;
+
+	while (count) {
+		if (!bz.rx_skb) {
+			u8 type = *data++;
+
+			count--;
+			switch (type) {
+			case HCI_EVENT_PKT:
+				bz.rx_need = HCI_EVENT_HDR_SIZE;
+				break;
+			case HCI_ACLDATA_PKT:
+				bz.rx_need = HCI_ACL_HDR_SIZE;
+				break;
+			default:
+				bt_dev_err(hdev, "unknown H4 packet type 0x%02x", type);
+				hdev->stat.err_rx++;
+				return;
+			}
+
+			bz.rx_skb = bt_skb_alloc(HCI_MAX_FRAME_SIZE, GFP_KERNEL);
+			if (!bz.rx_skb) {
+				hdev->stat.err_rx++;
+				return;
+			}
+			hci_skb_pkt_type(bz.rx_skb) = type;
+			bz.rx_payload = false;
+			continue;
+		}
+
+		skb = bz.rx_skb;
+		n = min_t(size_t, count, bz.rx_need);
+		skb_put_data(skb, data, n);
+		data += n;
+		count -= n;
+		bz.rx_need -= n;
+		if (bz.rx_need)
+			continue;
+
+		if (!bz.rx_payload) {
+			bz.rx_payload = true;
+			if (hci_skb_pkt_type(skb) == HCI_EVENT_PKT)
+				bz.rx_need = hci_event_hdr(skb)->plen;
+			else
+				bz.rx_need = __le16_to_cpu(hci_acl_hdr(skb)->dlen);
+
+			if (bz.rx_need > skb_tailroom(skb)) {
+				bt_dev_err(hdev, "H4 packet too long (%u)", bz.rx_need);
+				kfree_skb(skb);
+				bz.rx_skb = NULL;
+				hdev->stat.err_rx++;
+				return;
+			}
+			if (bz.rx_need)
+				continue;
+		}
+
+		if (hci_skb_pkt_type(skb) == HCI_EVENT_PKT)
+			hdev->stat.evt_rx++;
+		else
+			hdev->stat.acl_rx++;
+		hdev->stat.byte_rx += skb->len;
+		bz.rx_skb = NULL;
+		hci_recv_frame(hdev, skb);
+	}
+}
+
+static int scsc_bluez_rx_thread(void *data)
+{
+	struct hci_dev *hdev = data;
+	ssize_t n;
+
+	while (!kthread_should_stop()) {
+		n = bz.fops->read(&bz.file, bz.rx_buf, sizeof(bz.rx_buf), NULL);
+		if (READ_ONCE(bz.stopping))
+			break;
+		if (n < 0) {
+			bt_dev_err(hdev, "H4 read failed (%zd)", n);
+			break;
+		}
+		scsc_bluez_recv(hdev, bz.rx_buf, n);
+	}
+
+	/* close() stops the thread */
+	set_current_state(TASK_INTERRUPTIBLE);
+	while (!kthread_should_stop()) {
+		schedule();
+		set_current_state(TASK_INTERRUPTIBLE);
+	}
+	__set_current_state(TASK_RUNNING);
+
+	return 0;
+}
+
+static int scsc_bluez_open(struct hci_dev *hdev)
+{
+	int err;
+
+	/* starts the BT service: firmware, shared memory, interrupts */
+	err = bz.fops->open(NULL, &bz.file);
+	if (err)
+		return err;
+
+	WRITE_ONCE(bz.stopping, false);
+	bz.rx_thread = kthread_run(scsc_bluez_rx_thread, hdev, "scsc_bluez");
+	if (IS_ERR(bz.rx_thread)) {
+		err = PTR_ERR(bz.rx_thread);
+		bz.rx_thread = NULL;
+		bz.fops->release(NULL, &bz.file);
+	}
+
+	return err;
+}
+
+static int scsc_bluez_close(struct hci_dev *hdev)
+{
+	if (bz.rx_thread) {
+		/* the blocking read returns once an error is counted; release
+		 * clears the count
+		 */
+		WRITE_ONCE(bz.stopping, true);
+		atomic_inc(bz.error_count);
+		wake_up(bz.read_wait);
+		kthread_stop(bz.rx_thread);
+		bz.rx_thread = NULL;
+	}
+
+	kfree_skb(bz.rx_skb);
+	bz.rx_skb = NULL;
+
+	return bz.fops->release(NULL, &bz.file);
+}
+
+static int scsc_bluez_send(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	u8 type = hci_skb_pkt_type(skb);
+	ssize_t n;
+
+	/* the firmware has transfer rings for commands and ACL data only;
+	 * SCO audio goes through the audio DSP
+	 */
+	if (type != HCI_COMMAND_PKT && type != HCI_ACLDATA_PKT)
+		return -EILSEQ;
+
+	*(u8 *)skb_push(skb, 1) = type;
+	n = bz.fops->write(NULL, skb->data, skb->len, NULL);
+	if (n < 0) {
+		skb_pull(skb, 1);
+		return n;
+	}
+
+	if (type == HCI_COMMAND_PKT)
+		hdev->stat.cmd_tx++;
+	else
+		hdev->stat.acl_tx++;
+	hdev->stat.byte_tx += skb->len - 1;
+	kfree_skb(skb);
+
+	return 0;
+}
+
+static void scsc_bluez_work(struct work_struct *work)
+{
+	struct device *dev = READ_ONCE(bz.dev);
+	struct hci_dev *hdev;
+	int err;
+
+	if (READ_ONCE(bz.enable) && dev && !bz.hdev) {
+		hdev = hci_alloc_dev();
+		if (!hdev)
+			return;
+
+		hdev->bus = HCI_IPC;
+		SET_HCIDEV_DEV(hdev, dev);
+		hdev->open = scsc_bluez_open;
+		hdev->close = scsc_bluez_close;
+		hdev->send = scsc_bluez_send;
+
+		err = hci_register_dev(hdev);
+		if (err < 0) {
+			dev_err(dev, "hci_register_dev failed (%d)\n", err);
+			hci_free_dev(hdev);
+			return;
+		}
+		bz.hdev = hdev;
+	} else if (!READ_ONCE(bz.enable) && bz.hdev) {
+		hci_unregister_dev(bz.hdev);
+		hci_free_dev(bz.hdev);
+		bz.hdev = NULL;
+	}
+}
+
+/*
+ * Called by the BT service with its start mutex held; the HCI device is
+ * registered from a work, as its power on starts the service.
+ */
+void slsi_bt_notify_probe(struct device *dev,
+			  const struct file_operations *fs,
+			  atomic_t *error_count,
+			  wait_queue_head_t *read_wait)
+{
+	bz.fops = fs;
+	bz.error_count = error_count;
+	bz.read_wait = read_wait;
+	WRITE_ONCE(bz.dev, dev);
+	schedule_work(&bz.work);
+}
+
+/*
+ * The Maxwell core is gone, for a firmware recovery as a rule: hci0 stays,
+ * the service refuses to start until the core probes again.
+ */
+void slsi_bt_notify_remove(void)
+{
+	WRITE_ONCE(bz.dev, NULL);
+}
+
+static int scsc_bluez_enable_set(const char *val, const struct kernel_param *kp)
+{
+	int err = param_set_bool(val, kp);
+
+	if (!err)
+		schedule_work(&bz.work);
+	return err;
+}
+
+static const struct kernel_param_ops scsc_bluez_enable_ops = {
+	.set = scsc_bluez_enable_set,
+	.get = param_get_bool,
+};
+
+module_param_cb(enable, &scsc_bluez_enable_ops, &bz.enable, 0644);
+MODULE_PARM_DESC(enable, "Register hci0 once the firmware can be read (0 removes it)");
diff --git a/drivers/misc/samsung/scsc_bt/scsc_bluez.h b/drivers/misc/samsung/scsc_bt/scsc_bluez.h

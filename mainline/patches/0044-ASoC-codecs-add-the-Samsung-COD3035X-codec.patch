+static void cod3035x_lassenA_uhqa(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called. LassenA, UHQA Mode\n", __func__);
+
+	snd_soc_component_write(codec, COD3035X_F2_PRESET_AVC, 0x03);
+	snd_soc_component_write(codec, COD3035X_F3_PRESET_AVC, 0x1F);
+	snd_soc_component_write(codec, COD3035X_F5_PRESET_AVC, 0x10);
+	snd_soc_component_write(codec, COD3035X_F6_PRESET_AVC, 0x0F);
+	snd_soc_component_update_bits(codec, COD3035X_50_DAC1,
+			DAC1_INGN_MODE_MASK, DAC1_INGN_MODE_MASK);
+	snd_soc_component_update_bits(codec, COD3035X_53_UHQA,
+			UHQA_MODE_MASK, UHQA_ENABLE);
+	snd_soc_component_write(codec, COD3035X_58_AVC5, 0x81);
+	snd_soc_component_write(codec, COD3035X_7A_MAN_GN1, 0x2F);
+	snd_soc_component_write(codec, COD3035X_7B_MAN_GN2, 0xE6);
+
+#if 1
+	cod3035x_usleep(100);
+	cod3035a_write(codec, COD3035A_50_OFF_DLY1, 0x0F);
+	cod3035a_write(codec, COD3035A_51_OFF_DLY2, 0xB0);
+
+	cod3035x_usleep(100);
+//	snd_soc_component_write(codec, COD3035X_54_AVC1, 0x8F);
+	cod3035x_usleep(100);
+
+	cod3035a_write(codec, COD3035A_41_DNC1, 0x01);
+	cod3035a_write(codec, COD3035A_42_DNC2, 0xDA);
+	cod3035a_write(codec, COD3035A_43_DNC3, 0x32);
+	cod3035a_write(codec, COD3035A_44_DNC4, 0x32);
+	cod3035a_write(codec, COD3035A_4A_DNC10, 0xFE);
+	cod3035a_write(codec, COD3035A_4B_DNC11, 0x87);
+	cod3035a_write(codec, COD3035A_4C_DNC12, 0x10);
+	cod3035a_write(codec, COD3035A_4D_DNC13, 0x86);
+	cod3035a_write(codec, COD3035A_4E_DNC14, 0x00);
+	cod3035x_usleep(100);
+#endif
+
+	snd_soc_component_update_bits(codec, COD3035X_D6_CTRL_IREF5,
+			CTMF_DCT_CAP_MASK, CTMF_DTC_CAP_167KHZ << CTMF_DCT_CAP_SHIFT);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x66);
+	snd_soc_component_write(codec, COD3035X_B8_AUTO_HP9, 0x55);
+	/*
+	 * 0x7D (AVC_PARA29, 0x8B) is not in the register map, so the
+	 * downstream write never reached the codec: left out
+	 */
+	cod3035x_usleep(1000);
+}

+static int hp_avol_mode_put(struct snd_kcontrol *kcontrol,
+		struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	int value = ucontrol->value.integer.value[0];
+
+	dev_info(codec->dev, "%s: hp analog volume : %d\n",
+			__func__, value);
+
+	if (value >= 0) {
+		snd_soc_component_update_bits(codec, COD3035X_E3_PRESET_AVC,
+			HP_PN_MASK, 0x0);
+		snd_soc_component_update_bits(codec, COD3035X_E5_PRESET_AVC,
+			HP_PN_MASK, 0x0);
+		snd_soc_component_update_bits(codec, COD3035X_E3_PRESET_AVC,
+			HP_AVOL_MASK, value);
+		snd_soc_component_update_bits(codec, COD3035X_E5_PRESET_AVC,
+			HP_AVOL_MASK, value);
+	} else {
+		snd_soc_component_update_bits(codec, COD3035X_E3_PRESET_AVC,
+			HP_PN_MASK, HP_PN_MASK);
+		snd_soc_component_update_bits(codec, COD3035X_E5_PRESET_AVC,
+			HP_PN_MASK, HP_PN_MASK);
+		snd_soc_component_update_bits(codec, COD3035X_E3_PRESET_AVC,
+			HP_AVOL_MASK, -value);
+		snd_soc_component_update_bits(codec, COD3035X_E5_PRESET_AVC,
+			HP_AVOL_MASK, -value);
+	}
+
+	return 0;
+}

+/* special feature to damp down the DC offset on the receiver
+ *
+ * dampdown_dc_offset :
+ * 		make the DC offset convergence to 0
+ */
+static void dampdown_dc_offset(struct snd_soc_component *codec)
+{
+	int damping_value = 0, index = 0, msb = 0, write_value = 0;
+
+	/* damping down the DC offset
+	* 0xD7 : DC offset
+	* 0xDA : temporary storage
+	*/
+	damping_value = snd_soc_component_read(codec, 0xD7);
+	snd_soc_component_write(codec, 0xDA, damping_value);
+	msb = damping_value & 0x80;
+	damping_value = damping_value & 0x7F;
+
+	for (index = damping_value; index > 0; index-=2) {
+		write_value = index | msb;
+		snd_soc_component_write(codec, 0xD7, write_value);
+	}
+	write_value = msb | 0x0;
+	snd_soc_component_write(codec, 0xD7, write_value);
+}
+
+/* dampdown_dc_offset :
+ * 		make the DC offset convergence to the previous saved value in 0xDA
+ */
+static void dampup_dc_offset(struct snd_soc_component *codec)
+{
+	int damping_value = 0, index = 0, msb = 0, write_value = 0;
+
+	/* damping back the DC offset
+	* 0xD7 : DC offset
+	* 0xDA : temporary storage
+	*/
+	damping_value = snd_soc_component_read(codec, 0xDA);
+	msb = damping_value & 0x80;
+	damping_value = damping_value & 0x7F;
+
+	for (index=0; damping_value > index; index +=2 ) {
+		write_value = index | msb;
+		snd_soc_component_write(codec, 0xD7, write_value);
+	}
+	write_value = damping_value | msb;
+	snd_soc_component_write(codec, 0xD7, write_value);
+}
+
+static int epdrv_ev(struct snd_soc_dapm_widget *w,
+		struct snd_kcontrol *kcontrol, int event)
+{
+	int hp_on, ep_on;
+	int chop_val;
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	chop_val = snd_soc_component_read(codec, COD3035X_77_CHOP_DA);
+	hp_on = chop_val & EN_HP_CHOP_MASK;
+	ep_on = chop_val & EN_EP_CHOP_MASK;
+
+	if (!ep_on) {
+		dev_dbg(codec->dev, "%s called but ear-piece not enabled\n",
+				__func__);
+		return 0;
+	}
+
+	dev_dbg(codec->dev, "%s called, event = %d\n", __func__, event);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_write(codec, COD3035X_73_DSM1_DA, 0x40);
+		snd_soc_component_write(codec, COD3035X_74_DSM2_DA, 0x88);
+
+		snd_soc_component_update_bits(codec, COD3035X_54_AVC1,
+				AVC_BYPS_MASK, AVC_BYPS_MASK);
+
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				APW_EP_MASK | PW_AUTO_DA_MASK,
+				APW_EP_MASK | PW_AUTO_DA_MASK);
+
+		snd_soc_component_update_bits(codec, COD3035X_38_MIX_DA2,
+				EN_EP_MIX_DCTL_MASK, EN_EP_MIX_DCTL_MASK);
+
+		msleep(136);
+
+		/* damping down the DC offset
+		* 0xD7 : DC offset
+		* 0xDA : temporary storage
+		*/
+		if (cod3035x->model_feature_flag & MODEL_FLAG_EP_DC_OFFSET_SWEEP)
+			dampdown_dc_offset(codec);
+
+		snd_soc_component_update_bits(codec, COD3035X_78_CTRL_CP,
+				CTMF_CP_CLK_MASK, CTMF_CP_CLK_97_5KHZ << CTMF_CP_CLK_SHIFT);
+
+		break;
+
+	case SND_SOC_DAPM_PRE_PMD:
+
+		snd_soc_component_update_bits(codec, COD3035X_54_AVC1,
+				AVC_BYPS_MASK, 0x0);
+
+		snd_soc_component_update_bits(codec, COD3035X_78_CTRL_CP,
+			CTMF_CP_CLK_MASK, CTMF_CP_CLK_780KHZ << CTMF_CP_CLK_SHIFT);
+
+		snd_soc_component_write(codec, COD3035X_32_VOL_EP, 0x06);
+
+		/* damping back the DC offset
+		* 0xD7 : DC offset
+		* 0xDA : temporary storage
+		*/
+		if (cod3035x->model_feature_flag & MODEL_FLAG_EP_DC_OFFSET_SWEEP)
+			dampup_dc_offset(codec);
+
+		if (hp_on) {
+			snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+					APW_EP_MASK, 0x0);
+		} else {
+			snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+					PW_AUTO_DA_MASK | APW_EP_MASK, 0x0);
+		}
+		cod3035x_usleep(1000);
+
+		snd_soc_component_update_bits(codec, COD3035X_38_MIX_DA2,
+				EN_EP_MIX_DCTL_MASK, 0x0);
+
+		break;
+
+	default:
+		break;
+	}
+
+	return 0;
+}

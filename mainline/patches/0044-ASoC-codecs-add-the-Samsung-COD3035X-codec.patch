+	cod3035a_write(codec, COD3035A_4D_DNC13, 0x83);
+	cod3035a_write(codec, COD3035A_4E_DNC14, 0x10);
+	cod3035x_usleep(100);
+#endif
+//	snd_soc_component_write(codec, COD3035X_54_AVC1, 0x03);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x33);
+	/*
+	 * 0x7D (AVC_PARA29, 0x8B) is not in the register map, so the
+	 * downstream write never reached the codec: left out

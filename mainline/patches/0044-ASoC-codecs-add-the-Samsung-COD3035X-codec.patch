+static void cod3035x_reset_io_selector_bits(struct snd_soc_component *codec)
+{
+	/* Reset output selector bits */
+	snd_soc_component_update_bits(codec, COD3035X_77_CHOP_DA,
+			EN_HP_CHOP_MASK | EN_EP_CHOP_MASK, 0x0);
+}
+
+/*
+ * Configure the mic1 and mic2 bias voltages with default value or the value
+ * received from the device tree.
+ * Also configure the internal LDO voltage.
+ */
+static void cod3035x_configure_mic_bias(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	/* Configure Mic1 Bias Voltage */
+	snd_soc_component_update_bits(codec, COD3035X_19_CTRL_REF,
+			CTRV_MCB1_MASK,
+			(cod3035x->mic_bias1_voltage << CTRV_MCB1_SHIFT));
+
+	/* Configure Mic2 Bias Voltage */
+	snd_soc_component_update_bits(codec, COD3035X_83_CTR_MCB,
+			CTRV_MCB2_MASK,
+			(cod3035x->mic_bias2_voltage << CTRV_MCB2_SHIFT));
+
+	/* Configure Mic Bias LDO Voltage */
+	snd_soc_component_update_bits(codec, COD3035X_83_CTR_MCB,
+			CTRV_MCB_LDO_MASK,
+			(cod3035x->mic_bias_ldo_voltage << CTRV_MCB_LDO_SHIFT));
+}
+
+/**
+ * cod3035x_codec_initialize : To be called if f/w update fails
+ *
+ * In case the firmware is not present or corrupt, we should still be able to
+ * run the codec with decent parameters. This values are updated as per the
+ * latest stable firmware.
+ *
+ * The values provided in this function are hard-coded register values, and we
+ * need not update these values as per bit-fields.
+ */
+static void cod3035x_codec_initialize(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	dev_dbg(codec->dev, "%s called, setting defaults\n", __func__);
+
+	cod3035x->mic_status = 0;
+
+	snd_soc_component_write(codec, COD3035X_05_IRQ1M, 0x00);
+	snd_soc_component_write(codec, COD3035X_06_IRQ2M, 0x00);
+	snd_soc_component_write(codec, COD3035X_07_IRQ3M, 0x53);
+	snd_soc_component_write(codec, COD3035X_08_IRQ4M, 0x53);
+
+	/*
+	 * Control of threshold level
+	 * CTRV_GDET_VTH: 0.982V -> 1.2V
+	 * CTRV_LDET_VTH: 1.241V -> 1.636V
+	 * CTRV_SURGE_REFP: 3.2V -> 2.4V
+	 * CTRV_SURGE_REFN: -2.6V
+	 * If want this control, set 'dis_ovp_det_mode' in device tree file.
+	 */
+	if (cod3035x->dis_ovp_det_mode) {
+		snd_soc_component_write(codec, COD3035X_3D_OVP_1, 0xE6);
+		snd_soc_component_write(codec, COD3035X_84_CTR_POP1, 0xFC);
+	} else {
+		snd_soc_component_write(codec, COD3035X_3D_OVP_1, 0xD7);
+		snd_soc_component_write(codec, COD3035X_84_CTR_POP1, 0xBE);
+	}
+
+	snd_soc_component_write(codec, COD3035X_A6_IMP_CNT11, 0x42);
+	snd_soc_component_write(codec, COD3035X_93_CTR_DLY6, 0x00);
+	snd_soc_component_write(codec, COD3035X_94_JACK_CTR, 0x00);
+	snd_soc_component_write(codec, COD3035X_8E_CTR_DLY1, 0xC0);
+	snd_soc_component_write(codec, COD3035X_8F_CTR_DLY2, 0xC0);
+	/* Jack debounce time setting */
+	snd_soc_component_write(codec, COD3035X_8D_CTR_DBNC3,
+			cod3035x->jackin_dbnc_time | cod3035x->jackout_dbnc_time);
+
+	snd_soc_component_write(codec, COD3035X_9A_TEST3, 0x01);
+	snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xFF);
+
+	/* HP amplifier reference current to 8uA*/
+	snd_soc_component_write(codec, COD3035X_B0_AUTO_HP1, 0xA0);
+	snd_soc_component_write(codec, COD3035X_B4_AUTO_HP5, 0x01);
+	snd_soc_component_write(codec, COD3035X_B5_AUTO_HP6, 0xFC);
+	snd_soc_component_write(codec, COD3035X_B6_AUTO_HP7, 0xFF);
+	snd_soc_component_write(codec, COD3035X_B7_AUTO_HP8, 0xB7);
+	snd_soc_component_write(codec, COD3035X_B8_AUTO_HP9, 0x55);
+	snd_soc_component_write(codec, COD3035X_BA_AUTO_HP11, 0x02);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x66);
+	snd_soc_component_write(codec, COD3035X_BE_ODSEL2, 0x60);
+
+	/* Disable AVC mute function */
+	snd_soc_component_write(codec, COD3035X_54_AVC1, 0x8F);
+	snd_soc_component_write(codec, COD3035X_55_AVC2, 0x78);
+
+	/* Disable DRC function */
+	snd_soc_component_write(codec, COD3035X_57_AVC4, 0x00);
+
+	/* Preset register for AVC */
+	snd_soc_component_write(codec, COD3035X_E1_PRESET_AVC, 0xF1);
+	snd_soc_component_write(codec, COD3035X_E3_PRESET_AVC, 0x00);
+	snd_soc_component_write(codec, COD3035X_E5_PRESET_AVC, 0x00);
+	snd_soc_component_write(codec, COD3035X_E7_PRESET_AVC, 0x00);
+	snd_soc_component_write(codec, COD3035X_E8_PRESET_AVC, 0x00);
+	snd_soc_component_write(codec, COD3035X_E9_PRESET_AVC, 0x00);
+	snd_soc_component_write(codec, COD3035X_EA_PRESET_AVC, 0x01);
+	snd_soc_component_write(codec, COD3035X_F2_PRESET_AVC, 0x03);
+	snd_soc_component_write(codec, COD3035X_F3_PRESET_AVC, 0x1F);
+	snd_soc_component_write(codec, COD3035X_F4_PRESET_AVC, 0x55);
+	snd_soc_component_write(codec, COD3035X_5A_AVC7, 0x44);
+	snd_soc_component_write(codec, COD3035X_F5_PRESET_AVC, 0x1A);
+	snd_soc_component_write(codec, COD3035X_F6_PRESET_AVC, 0xC6);
+	snd_soc_component_write(codec, COD3035X_1B_SDM_STR, 0x01);
+
+	snd_soc_component_write(codec, COD3035X_80_PDB_ACC1, 0x02);
+	msleep(100);
+	snd_soc_component_write(codec, COD3035X_80_PDB_ACC1, 0x03);
+	snd_soc_component_update_bits(codec, COD3035X_81_PDB_ACC2,
+			T_PDB_IMP_MASK, T_PDB_IMP_MASK);
+
+	/* MIC Boost LPF On */
+	snd_soc_component_write(codec, COD3035X_7C_LPF_AD, 0x1F);
+
+	/* Default value, enabling HPF and setting freq at 100Hz */
+	snd_soc_component_write(codec, COD3035X_46_ADC1, 0x0c);
+	snd_soc_component_write(codec, COD3035X_4B_ADC2, 0x0c);
+
+	snd_soc_component_update_bits(codec, COD3035X_D0_CTRL_IREF1,
+			CTMI_VCM_MASK | CTMI_MIX_MASK,
+			(CTMI_VCM_4U << CTMI_VCM_SHIFT) | CTMI_MIX_2U);
+
+	snd_soc_component_update_bits(codec, COD3035X_D1_CTRL_IREF2,
+			CTMI_INT1_MASK, CTMI_INT1_4U);
+
+	snd_soc_component_update_bits(codec, COD3035X_D2_CTRL_IREF3,
+			CTMI_MIC2_MASK | CTMI_MIC1_MASK,
+			(CTMI_MIC2_2U << CTMI_MIC2_SHIFT) | CTMI_MIC1_2U);
+
+	snd_soc_component_update_bits(codec, COD3035X_D3_CTRL_IREF4,
+			CTMI_MIC_BUFF_MASK | CTMI_MIC3_MASK,
+			(CTMI_MIC_BUFF_2U << CTMI_MIC_BUFF_SHIFT) | CTMI_MIC3_2U);
+
+	snd_soc_component_write(codec, COD3035X_47_AVOLL1, 0x18);
+	snd_soc_component_write(codec, COD3035X_48_AVOLR1, 0x18);
+	/* Boost 20 dB, Gain 0 dB for MIC1/MIC2/MIC3 */
+	snd_soc_component_write(codec, COD3035X_20_VOL_AD1, 0x54);
+	snd_soc_component_write(codec, COD3035X_21_VOL_AD2, 0x54);
+	snd_soc_component_write(codec, COD3035X_22_VOL_AD3, 0x54);
+	snd_soc_component_write(codec, COD3035X_22_VOL_AD3, 0x54);
+
+	/* default HP Volume setting */
+	snd_soc_component_write(codec, COD3035X_30_VOL_HPL, 0x0A);
+	snd_soc_component_write(codec, COD3035X_31_VOL_HPR, 0x0A);
+	snd_soc_component_write(codec, COD3035X_51_DVOLL, 0x54);
+	snd_soc_component_write(codec, COD3035X_52_DVOLR, 0x54);
+	snd_soc_component_write(codec, COD3035X_10_PD_REF, 0x10);
+
+	/* Change receiver REF current */
+	switch (cod3035x->rcv_drv_current) {
+		case 0:
+		snd_soc_component_update_bits(codec, COD3035X_DC_CTRL_EPS,
+			CTMI_EP_A_MASK, (CTMI_EP_A_1_UA << CTMI_EP_A_SHIFT));
+			break;
+		case 1:
+		snd_soc_component_update_bits(codec, COD3035X_DC_CTRL_EPS,
+			CTMI_EP_A_MASK, (CTMI_EP_A_2_UA << CTMI_EP_A_SHIFT));
+			break;
+		case 2:
+		snd_soc_component_update_bits(codec, COD3035X_DC_CTRL_EPS,
+			CTMI_EP_A_MASK, (CTMI_EP_A_3_UA << CTMI_EP_A_SHIFT));
+			break;
+		case 3:
+		snd_soc_component_update_bits(codec, COD3035X_DC_CTRL_EPS,
+			CTMI_EP_A_MASK, (CTMI_EP_A_4_UA << CTMI_EP_A_SHIFT));
+			break;
+		default:
+		snd_soc_component_update_bits(codec, COD3035X_DC_CTRL_EPS,
+			CTMI_EP_A_MASK, (CTMI_EP_A_4_UA << CTMI_EP_A_SHIFT));
+			break;
+	}
+
+
+	/* Configure mic bias voltage */
+	cod3035x_configure_mic_bias(codec);
+}
+
+
+/*
+ * The codec stays powered: its supplies are always on and ABOX, which gives
+ * it the master clock, is never suspended either.
+ */
+static int cod3035x_component_probe(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+	struct snd_soc_dapm_context *dapm = snd_soc_component_to_dapm(codec);
+
+	cod3035x->component = codec;
+
+	/* MCLK from ABOX before the first register access */
+	abox_enable_mclk(true);
+
+	/* jack detect clock on; the codec loads its OTP within 15 ms */
+	snd_soc_component_update_bits(codec, COD3035X_80_PDB_ACC1,
+			PDB_JD_CLK_EN_MASK, PDB_JD_CLK_EN_MASK);
+	usleep_range(15000, 16000);
+	cod3035x_reset_io_selector_bits(codec);
+
+	msleep(20);
+	cod3035x_codec_initialize(codec);
+
+	/* additional codec initialize for lassen A */
+	if (cod3035x->is_lassenA) {
+		cod3035x_lassenA_normal(codec);
+		snd_soc_component_write(codec, COD3035X_57_AVC4, 0x80);
+		snd_soc_component_write(codec, COD3035X_BE_ODSEL2, 0x00);
+		snd_soc_component_write(codec, COD3035X_5A_AVC7, 0x05);
+		snd_soc_component_write(codec, COD3035X_55_AVC2, 0x6E);
+		snd_soc_component_write(codec, COD3035X_F4_ACV_10, 0xD3);
+		snd_soc_component_write(codec, COD3035X_E9_PRESET_AVC, 0x1F);
+		snd_soc_component_write(codec, COD3035X_EA_PRESET_AVC, 0x1F);
+		snd_soc_component_write(codec, COD3035X_E1_PRESET_AVC, 0x22);
+	}
+	cod3035x->is_probe_done = true;
+
+	snd_soc_dapm_ignore_suspend(dapm, "HPOUTLN");
+	snd_soc_dapm_ignore_suspend(dapm, "EPOUTN");
+	snd_soc_dapm_ignore_suspend(dapm, "IN1L");
+	snd_soc_dapm_ignore_suspend(dapm, "IN2L");
+	snd_soc_dapm_ignore_suspend(dapm, "IN3L");
+	snd_soc_dapm_ignore_suspend(dapm, "IN4L");
+	snd_soc_dapm_ignore_suspend(dapm, "AIF Playback");
+	snd_soc_dapm_ignore_suspend(dapm, "AIF Capture");
+	snd_soc_dapm_ignore_suspend(dapm, "AIF2 Playback");
+	snd_soc_dapm_ignore_suspend(dapm, "AIF2 Capture");
+
+	return 0;
+}
+
+static void cod3035x_component_remove(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	cancel_work_sync(&cod3035x->adc_mute_work);
+	abox_enable_mclk(false);
+}

+static int dac_ev(struct snd_soc_dapm_widget *w, struct snd_kcontrol *kcontrol,
+		int event)
+{
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+
+	dev_dbg(codec->dev, "%s called, event = %d\n", __func__, event);
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		/* DAC digital power On */
+		snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+				PDB_DACDIG_MASK, PDB_DACDIG_MASK);
+
+		/* DAC digital Reset On/Off */
+		snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+				RSTB_DAT_DA_MASK, 0x0);
+		snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+				RSTB_DAT_DA_MASK, RSTB_DAT_DA_MASK);
+		break;
+
+	case SND_SOC_DAPM_PRE_PMD:
+		/* DAC digital Reset Off */
+		snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+				RSTB_DAT_DA_MASK, 0x0);
+
+		/* DAC digital power Off */
+		snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+				PDB_DACDIG_MASK, 0x0);
+		break;
+
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static void cod3035x_adc_digital_mute(struct snd_soc_component *codec, bool on)
+{
+	dev_dbg(codec->dev, "%s called, %s\n", __func__,
+			on ? "Mute" : "Unmute");
+
+	if (on)
+		snd_soc_component_update_bits(codec, COD3035X_46_ADC1,
+				ADC1_MUTE_AD_EN_MASK, ADC1_MUTE_AD_EN_MASK);
+	else
+		snd_soc_component_update_bits(codec, COD3035X_46_ADC1,
+				ADC1_MUTE_AD_EN_MASK, 0);
+}
+
+static int cod3035x_capture_init_manual_mode(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	snd_soc_component_write(codec, COD3035X_BC_ODSEL0, 0x03);
+
+	/* VMID On */
+	snd_soc_component_update_bits(codec, COD3035X_10_PD_REF,
+			PDB_VMID_MASK, PDB_VMID_MASK);
+
+	/* VMID Fast Charging On */
+	snd_soc_component_update_bits(codec, COD3035X_19_CTRL_REF,
+			CTMF_VMID_MASK, (CTMF_VMID_1K_OM << CTMF_VMID_SHIFT));
+
+	/* VREFP_AD Pre Charging ON */
+	snd_soc_component_update_bits(codec, COD3035X_11_PD_AD1,
+			EN_DSML_PREQ_MASK|EN_DSMR_PREQ_MASK,
+			EN_DSML_PREQ_MASK|EN_DSMR_PREQ_MASK);
+	snd_soc_component_update_bits(codec, COD3035X_13_PD_AD3,
+			EN_DSMC_PREQ_MASK, EN_DSMC_PREQ_MASK);
+
+	/* IGEN On */
+	snd_soc_component_update_bits(codec, COD3035X_10_PD_REF,
+			PDB_IGEN_MASK, PDB_IGEN_MASK);
+
+	return 0;
+}
+
+static int cod3035x_capture_init(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	mutex_lock(&cod3035x->adc_mute_lock);
+	snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xFF);
+	/* Enable ADC digital mute before configuring ADC */
+	cod3035x_adc_digital_mute(codec, true);
+	mutex_unlock(&cod3035x->adc_mute_lock);
+
+	/* DAC digital power On */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			PDB_DACDIG_MASK, PDB_DACDIG_MASK);
+
+	/* Recording Digital Power on */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			PDB_ADCDIG_MASK, PDB_ADCDIG_MASK);
+
+	/* Recording Digital Reset on/off */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			RSTB_DAT_AD_MASK, 0);
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			RSTB_DAT_AD_MASK, RSTB_DAT_AD_MASK);
+
+	/* Power up ADC channel 2 */
+	snd_soc_component_update_bits(codec, COD3035X_4B_ADC2,
+			ADC2_PDB_ADCDIG2_MASK, ADC2_PDB_ADCDIG2_MASK);
+
+	cod3035x_capture_init_manual_mode(codec);
+
+	return 0;
+}
+
+static int cod3035x_dmic_capture_init(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	mutex_lock(&cod3035x->adc_mute_lock);
+	snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xFF);
+	/* enable ADC digital mute before configuring ADC */
+	cod3035x_adc_digital_mute(codec, true);
+	mutex_unlock(&cod3035x->adc_mute_lock);
+	/* Recording Digital  Power on */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			PDB_ADCDIG_MASK, PDB_ADCDIG_MASK);
+
+	/* Recording Digital Reset on/off */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			RSTB_DAT_AD_MASK, 0x0);
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			RSTB_DAT_AD_MASK, RSTB_DAT_AD_MASK);
+
+	/* Power up ADC channel 2 */
+	snd_soc_component_update_bits(codec, COD3035X_4B_ADC2,
+			ADC2_PDB_ADCDIG2_MASK, ADC2_PDB_ADCDIG2_MASK);
+
+	return 0;
+}
+
+static void cod3035x_capture_deinit_manual_mode(struct snd_soc_component *codec)
+{
+	/* VMID OFF */
+	snd_soc_component_update_bits(codec, COD3035X_10_PD_REF, PDB_VMID_MASK, 0);
+
+	snd_soc_component_write(codec, COD3035X_BC_ODSEL0, 0x00);
+}
+
+static int cod3035x_capture_deinit(struct snd_soc_component *codec)
+{
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	dev_dbg(codec->dev, "%s called\n", __func__);
+	cod3035x_capture_deinit_manual_mode(codec);
+
+	/* Power down ADC channel 2 */
+	snd_soc_component_update_bits(codec, COD3035X_4B_ADC2, ADC2_PDB_ADCDIG2_MASK, 0);
+
+	/* Recording Digital Reset on */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			RSTB_DAT_AD_MASK, 0);
+
+	/* Recording Digital Power off */
+	snd_soc_component_update_bits(codec, COD3035X_40_DIGITAL_POWER,
+			PDB_ADCDIG_MASK, 0);
+
+	mutex_lock(&cod3035x->adc_mute_lock);
+	snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xFF);
+	mutex_unlock(&cod3035x->adc_mute_lock);
+
+	return 0;
+}

+static int cod3035x_dai_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct snd_soc_component *codec = dai->component;
+
+	dev_dbg(codec->dev, "%s called. fmt: %d\n", __func__, fmt);
+	/* I2S Mode */
+	snd_soc_component_write(codec, COD3035X_41_IF1_FORMAT1, 0x00);
+
+	/* length set to 16 bits */
+	snd_soc_component_write(codec, COD3035X_42_IF1_FORMAT2, 0x10);
+
+	/* BCLK : 32fs */
+	snd_soc_component_write(codec, COD3035X_43_IF1_FORMAT3, 0x20);
+
+	return 0;
+}
+
+static int cod3035x_dai_startup(struct snd_pcm_substream *substream,
+		struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *codec = dai->component;
+
+	dev_dbg(codec->dev, "(%s) %s completed\n",
+			substream->stream ? "C" : "P", __func__);
+
+	return 0;
+}
+
+static void cod3035x_dai_shutdown(struct snd_pcm_substream *substream,
+		struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *codec = dai->component;
+
+	dev_dbg(codec->dev, "(%s) %s completed\n",
+			substream->stream ? "C" : "P", __func__);
+}
+
+static void cod3035x_adc_mute_work(struct work_struct *work)
+{
+	struct cod3035x_priv *cod3035x =
+		container_of(work, struct cod3035x_priv, adc_mute_work);
+	struct snd_soc_component *codec = cod3035x->component;
+
+	mutex_lock(&cod3035x->adc_mute_lock);
+	msleep(200);
+	dev_dbg(codec->dev, "%s called\n", __func__);
+	cod3035x_adc_digital_mute(codec, false);
+	cod3035x_usleep(2000);
+	if (cod3035x->uhqa_rec_mode)
+		snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xEA);
+	else
+		snd_soc_component_write(codec, COD3035X_44_IF1_FORMAT4, 0xE4);
+	mutex_unlock(&cod3035x->adc_mute_lock);
+}
+
+static void cod3035x_legacy_uhqa(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called. UHQA Mode\n", __func__);
+
+	snd_soc_component_write(codec, COD3035X_F2_PRESET_AVC, 0x03);
+	snd_soc_component_write(codec, COD3035X_F3_PRESET_AVC, 0x1F);
+	snd_soc_component_write(codec, COD3035X_F4_PRESET_AVC, 0x5F);
+	snd_soc_component_write(codec, COD3035X_5A_AVC7, 0xFF);
+	snd_soc_component_write(codec, COD3035X_F5_PRESET_AVC, 0x10);
+	snd_soc_component_write(codec, COD3035X_F6_PRESET_AVC, 0x0F);
+	snd_soc_component_update_bits(codec, COD3035X_50_DAC1,
+			DAC1_INGN_MODE_MASK, DAC1_UHQA_MODE);
+	snd_soc_component_update_bits(codec, COD3035X_53_UHQA,
+			UHQA_MODE_MASK, UHQA_ENABLE);
+	snd_soc_component_write(codec, COD3035X_7A_MAN_GN1, 0x2F);
+	snd_soc_component_write(codec, COD3035X_7B_MAN_GN2, 0xE6);
+	snd_soc_component_update_bits(codec, COD3035X_D6_CTRL_IREF5,
+			CTMF_DCT_CAP_MASK,
+			CTMF_DTC_CAP_167KHZ << CTMF_DCT_CAP_SHIFT);
+	snd_soc_component_write(codec, COD3035X_B8_AUTO_HP9, 0x55);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x66);
+}
+
+static void cod3035x_legacy_normal(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called. NOT UHQA Mode\n", __func__);
+
+	snd_soc_component_write(codec, COD3035X_F2_PRESET_AVC, 0x03);
+	snd_soc_component_write(codec, COD3035X_F3_PRESET_AVC, 0x1F);
+	snd_soc_component_write(codec, COD3035X_F4_PRESET_AVC, 0x55);
+	snd_soc_component_write(codec, COD3035X_5A_AVC7, 0x44);
+	snd_soc_component_write(codec, COD3035X_F5_PRESET_AVC, 0x1A);
+	snd_soc_component_write(codec, COD3035X_F6_PRESET_AVC, 0xC6);
+	snd_soc_component_update_bits(codec, COD3035X_50_DAC1,
+		DAC1_INGN_MODE_MASK, DAC1_NORMAL_MODE);
+	snd_soc_component_update_bits(codec, COD3035X_53_UHQA,
+		UHQA_MODE_MASK, UHQA_DISABLE);
+	snd_soc_component_write(codec, COD3035X_7A_MAN_GN1, 0x27);
+	snd_soc_component_write(codec, COD3035X_7B_MAN_GN2, 0xE7);
+	snd_soc_component_update_bits(codec, COD3035X_D6_CTRL_IREF5,
+		CTMF_DCT_CAP_MASK,
+		CTMF_DTC_CAP_87KHZ << CTMF_DCT_CAP_SHIFT);
+	snd_soc_component_write(codec, COD3035X_B8_AUTO_HP9, 0x11);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x33);
+}

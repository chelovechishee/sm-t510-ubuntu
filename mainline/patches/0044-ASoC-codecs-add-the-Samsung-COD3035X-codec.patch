+static int cod3035x_hp_playback_init(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	/* 0x45: |0x10, DAC Input Data Selection */
+	snd_soc_component_update_bits(codec, COD3035X_45_IF1_FORMAT5, 0x10, 0x10);
+	snd_soc_component_write(codec, COD3035X_73_DSM1_DA, 0x20);
+	snd_soc_component_write(codec, COD3035X_74_DSM2_DA, 0x89);
+
+	cod3035x_usleep(100);
+
+	return 0;
+}
+
+/* 0, 1: LEGACY mode */
+static int post_hpdrv_legacy(struct snd_soc_component *codec,
+		int avc_val, int hp_avol)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	if (avc_val & AVC_BYPS_MASK) {
+		snd_soc_component_update_bits(codec, COD3035X_54_AVC1,
+				DAC_VOL_BYPS_MASK | AVC_BYPS_MASK,
+				DAC_VOL_BYPS_MASK | AVC_BYPS_MASK);
+		snd_soc_component_write(codec, COD3035X_B9_AUTO_HP10, hp_avol);
+	}
+
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK);
+
+	snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+			APW_HP_MASK, APW_HP_MASK);
+
+	msleep(135);
+
+	cod3035x_dac_mute(codec, false);
+	snd_soc_component_write(codec, COD3035X_BA_AUTO_HP11, 0x05);
+
+	snd_soc_component_update_bits(codec, COD3035X_3E_OVP_2,
+			LOCK_UP_TIME_SLOT_MASK | OVP_APON_MASK,
+			LOCK_UP_TIME_1_5 << LOCK_UP_TIME_SLOT_SHIFT | OVP_APON_MASK);
+
+	if (avc_val & AVC_BYPS_MASK)
+		snd_soc_component_write(codec, COD3035X_BE_ODSEL2, 0x60);
+
+	return 0;
+}
+
+/* 2: NORMAL_mode */
+static int post_hpdrv_normal(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	//snd_soc_component_write(codec, COD3035X_54_AVC1, 0x03);
+	snd_soc_component_write(codec, 0x33, 0x00);
+	snd_soc_component_write(codec, 0xBB, 0x33);
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK);
+
+	snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+			APW_HP_MASK, APW_HP_MASK);
+
+	msleep(135);
+
+	cod3035x_dac_mute(codec, false);
+	snd_soc_component_update_bits(codec, COD3035X_3E_OVP_2,
+			LOCK_UP_TIME_SLOT_MASK | OVP_APON_MASK,
+			LOCK_UP_TIME_1_5 << LOCK_UP_TIME_SLOT_SHIFT | OVP_APON_MASK);
+
+	return 0;
+}
+
+/* 3: UHQA_mode */
+static int post_hpdrv_uhqa(struct snd_soc_component *codec)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	//snd_soc_component_write(codec, COD3035X_54_AVC1, 0x03);
+	snd_soc_component_write(codec, 0x33, 0x00);
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK);
+	snd_soc_component_write(codec, COD3035X_BB_AUTO_HP12, 0x66);
+	snd_soc_component_write(codec, COD3035X_B8_AUTO_HP9, 0x55);
+
+	snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+			APW_HP_MASK, APW_HP_MASK);
+
+	msleep(135);
+
+	cod3035x_dac_mute(codec, false);
+	snd_soc_component_write(codec, COD3035X_3E_OVP_2, 0x12);
+
+	return 0;
+}
+
+/* EAR Power Off */
+static int normal_ear_power_off(struct snd_soc_component *codec, int ep_on)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	/* 0x18 <-- 0x00: ~0x02, HP Path Auto Power Off */
+	if (ep_on) {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				APW_HP_MASK, 0);
+	} else {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				PW_AUTO_DA_MASK | APW_HP_MASK, 0);
+	}
+
+	cod3035x_usleep(3000);
+
+	snd_soc_component_update_bits(codec, COD3035X_3E_OVP_2,
+		OVP_APON_MASK, 0);
+
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK, 0);
+	snd_soc_component_write(codec, COD3035X_F6_ACV_DECAY1, 0xC7);
+
+	return 0;
+}
+
+static int uhqa_ear_power_off(struct snd_soc_component *codec, int ep_on)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	/* 0x18 <-- 0x00: ~0x02, HP Path Auto Power Off */
+	if (ep_on) {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				APW_HP_MASK, 0);
+	} else {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				PW_AUTO_DA_MASK | APW_HP_MASK, 0);
+	}
+
+	cod3035x_usleep(3000);
+
+	snd_soc_component_write(codec, COD3035X_D6_CTRL_IREF5, 0x59);
+	snd_soc_component_write(codec, COD3035X_DB_CTRL_HPS, 0x5E);
+
+	snd_soc_component_update_bits(codec, COD3035X_3E_OVP_2,
+			OVP_APON_MASK, 0);
+
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK, 0);
+
+	return 0;
+}
+
+static int legacy_ear_power_off(struct snd_soc_component *codec, int ep_on)
+{
+	dev_dbg(codec->dev, "%s called\n", __func__);
+
+	snd_soc_component_write(codec, COD3035X_BA_AUTO_HP11, 0x02);
+
+	/* 0x18 <-- 0x00: ~0x02, HP Path Auto Power Off */
+	if (ep_on) {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				APW_HP_MASK, 0);
+	} else {
+		snd_soc_component_update_bits(codec, COD3035X_18_PWAUTO_DA,
+				PW_AUTO_DA_MASK | APW_HP_MASK, 0);
+	}
+
+	cod3035x_usleep(3000);
+
+	snd_soc_component_update_bits(codec, COD3035X_3E_OVP_2,
+			OVP_APON_MASK, 0);
+
+	snd_soc_component_update_bits(codec, COD3035X_37_MIX_DA1,
+			EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK, 0);
+
+	return 0;
+}
+
+static int hpdrv_ev(struct snd_soc_dapm_widget *w,
+		struct snd_kcontrol *kcontrol, int event)
+{
+	int hp_on, ep_on;
+	int chop_val;
+	int avc_val;
+	int hp_avol;
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+	struct cod3035x_priv *cod3035x = snd_soc_component_get_drvdata(codec);
+
+	avc_val = snd_soc_component_read(codec, COD3035X_54_AVC1);
+	hp_avol = snd_soc_component_read(codec, COD3035X_30_VOL_HPL);
+	chop_val = snd_soc_component_read(codec, COD3035X_77_CHOP_DA);
+	hp_on = chop_val & EN_HP_CHOP_MASK;
+	ep_on = chop_val & EN_EP_CHOP_MASK;
+
+	if (!hp_on) {
+		dev_dbg(codec->dev, "%s called but headphone not enabled\n",
+				__func__);
+		return 0;
+	}
+
+	dev_dbg(codec->dev, "%s called, event = %d, avc_mode: %d\n",
+			__func__, event, g_avc_mode);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		cod3035x_dac_mute(codec, true);
+		cod3035x_hp_playback_init(codec);
+		break;
+
+	case SND_SOC_DAPM_POST_PMU:
+		if (cod3035x->is_lassenA) {
+			if (cod3035x->playback_aifrate == COD3035X_SAMPLE_RATE_192KHZ)
+				post_hpdrv_uhqa(codec);
+			else
+				post_hpdrv_normal(codec);
+		} else {
+			post_hpdrv_legacy(codec, avc_val, hp_avol);
+		}
+		break;
+
+	case SND_SOC_DAPM_PRE_PMD:
+		cod3035x_dac_mute(codec, true);
+		msleep(100);
+		if (cod3035x->is_lassenA) {
+			if (cod3035x->playback_aifrate == COD3035X_SAMPLE_RATE_192KHZ)
+				uhqa_ear_power_off(codec, ep_on);
+			else
+				normal_ear_power_off(codec, ep_on);
+		} else {
+			legacy_ear_power_off(codec, ep_on);
+		}
+		break;
+
+	default:
+		break;
+	}
+
+	return 0;
+}

+/* Lassen A02 revision flag in PMIC register 0x59 (SPEEDY device 1) */
+static bool cod3035x_is_lassenA02(struct i2c_client *i2c)
+{
+	u8 reg = COD3035X_LASSENA02_ADDR, val = 0;
+	struct i2c_msg msgs[] = {
+		{ .addr = COD3035X_SPEEDY_PMIC, .len = 1, .buf = &reg },
+		{ .addr = COD3035X_SPEEDY_PMIC, .flags = I2C_M_RD,
+		  .len = 1, .buf = &val },
+	};
+
+	if (i2c_transfer(i2c->adapter, msgs, ARRAY_SIZE(msgs)) != 2) {
+		dev_warn(&i2c->dev, "cannot read the PMIC revision flag\n");
+		return false;
+	}
+	return val & COD3035X_LASSENA02_MASK;
+}
+
+static void cod3035x_parse_dt(struct cod3035x_priv *cod3035x)
+{
+	struct device_node *np = cod3035x->dev->of_node;
+	u32 val;
+
+	cod3035x->mic_bias1_voltage = MIC_BIAS1_VO_3_0V;
+	if (!of_property_read_u32(np, "samsung,mic-bias1-voltage", &val) &&
+	    val >= MIC_BIAS1_VO_2_8V && val <= MIC_BIAS1_VO_3_0V)
+		cod3035x->mic_bias1_voltage = val;
+
+	cod3035x->mic_bias2_voltage = MIC_BIAS2_VO_3_0V;
+	if (!of_property_read_u32(np, "samsung,mic-bias2-voltage", &val) &&
+	    val >= MIC_BIAS2_VO_2_8V && val <= MIC_BIAS2_VO_3_0V)
+		cod3035x->mic_bias2_voltage = val;
+
+	cod3035x->mic_bias_ldo_voltage = MIC_BIAS_LDO_VO_3_3V;
+	if (!of_property_read_u32(np, "samsung,mic-bias-ldo-voltage", &val) &&
+	    val >= MIC_BIAS_LDO_VO_2_8V && val <= MIC_BIAS_LDO_VO_3_3V)
+		cod3035x->mic_bias_ldo_voltage = val;
+
+	/* receiver driving current; 3 is the Lassen X default */
+	cod3035x->rcv_drv_current = 3;
+	of_property_read_u32(np, "samsung,rcv-drv-current",
+			     &cod3035x->rcv_drv_current);
+
+	cod3035x->model_feature_flag = 0;
+	of_property_read_u32(np, "samsung,feature-flag",
+			     &cod3035x->model_feature_flag);
+
+	cod3035x->jackin_dbnc_time = COD3035X_JACKIN_DBNC_DEFAULT;
+	if (!of_property_read_u32(np, "samsung,jackin-dbnc-time", &val))
+		cod3035x->jackin_dbnc_time = val & COD3035X_JACKIN_DBNC_MASK;
+
+	cod3035x->jackout_dbnc_time = COD3035X_JACKOUT_DBNC_DEFAULT;
+	if (!of_property_read_u32(np, "samsung,jackout-dbnc-time", &val))
+		cod3035x->jackout_dbnc_time = val & COD3035X_JACKOUT_DBNC_MASK;
+
+	cod3035x->dis_ovp_det_mode =
+		of_property_read_bool(np, "samsung,dis-ovp-det-mode");
+	cod3035x->is_lassenA = of_property_read_bool(np, "samsung,lassen-a");
+}
+
+/* LDO36 and LDO37 of the PMIC */
+static const char * const cod3035x_supplies[] = { "vdd", "vdd2" };
+
+static int cod3035x_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct cod3035x_priv *cod3035x;
+	struct i2c_client *analog;
+	int ret;
+
+	cod3035x = devm_kzalloc(dev, sizeof(*cod3035x), GFP_KERNEL);
+	if (!cod3035x)
+		return -ENOMEM;
+	cod3035x->dev = dev;
+
+	cod3035x->regmap = devm_regmap_init_i2c(i2c, &cod3035x_regmap);
+	if (IS_ERR(cod3035x->regmap))
+		return dev_err_probe(dev, PTR_ERR(cod3035x->regmap),
+				     "digital block regmap\n");
+
+	analog = devm_i2c_new_dummy_device(dev, i2c->adapter,
+					   COD3035X_SPEEDY_CODECA);
+	if (IS_ERR(analog))
+		return dev_err_probe(dev, PTR_ERR(analog),
+				     "analog block at SPEEDY device %d\n",
+				     COD3035X_SPEEDY_CODECA);
+	cod3035x->regmap_a = devm_regmap_init_i2c(analog, &cod3035a_regmap);
+	if (IS_ERR(cod3035x->regmap_a))
+		return dev_err_probe(dev, PTR_ERR(cod3035x->regmap_a),
+				     "analog block regmap\n");
+
+	ret = devm_regulator_bulk_get_enable(dev, ARRAY_SIZE(cod3035x_supplies),
+					     cod3035x_supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "supplies\n");
+
+	cod3035x_parse_dt(cod3035x);
+	if (cod3035x->is_lassenA && cod3035x_is_lassenA02(i2c))
+		cod3035x->is_lassenA = 2;
+	dev_info(dev, "Lassen A revision %d\n", cod3035x->is_lassenA);
+
+	mutex_init(&cod3035x->adc_mute_lock);
+	INIT_WORK(&cod3035x->adc_mute_work, cod3035x_adc_mute_work);
+	cod3035x->adc_mute_wq = devm_alloc_ordered_workqueue(dev,
+			"cod3035x_adc_mute", 0);
+	if (!cod3035x->adc_mute_wq)
+		return -ENOMEM;
+
+	i2c_set_clientdata(i2c, cod3035x);
+
+	return devm_snd_soc_register_component(dev, &soc_component_dev_cod3035x,
+			cod3035x_dai, ARRAY_SIZE(cod3035x_dai));
+}
+
+static const struct of_device_id cod3035x_of_match[] = {
+	{ .compatible = "samsung,cod3035x" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cod3035x_of_match);
+
+static struct i2c_driver cod3035x_i2c_driver = {
+	.driver = {
+		.name = "cod3035x",
+		.of_match_table = cod3035x_of_match,
+	},
+	.probe = cod3035x_i2c_probe,
+};
+module_i2c_driver(cod3035x_i2c_driver);
+
+MODULE_DESCRIPTION("ASoC Samsung COD3035X codec driver");
+MODULE_LICENSE("GPL");

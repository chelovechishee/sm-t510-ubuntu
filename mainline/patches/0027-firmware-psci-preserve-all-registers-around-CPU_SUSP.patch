From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 27/43] firmware: psci: preserve all registers around
 CPU_SUSPEND on SMC

The Exynos 7885 EL3 monitor returns from a denied CPU_SUSPEND (an interrupt
arrived on the way down) with x19-x28 overwritten, against the SMC calling
convention. The caller then crashed on its own registers, e.g. a NULL dev
in cpuidle_enter_state(), or corrupted memory. Issue CPU_SUSPEND with all
general purpose registers but the frame pointer declared clobbered, so the
compiler saves and restores them around the SMC.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/firmware/psci/psci.c | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb..a69fa6650 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -173,12 +173,44 @@ int psci_set_osi_mode(bool enable)
 	return psci_to_linux_errno(err);
 }
 
+/*
+ * CPU_SUSPEND through SMC with every general purpose register but the frame
+ * pointer treated as clobbered. The Samsung Exynos 7885 EL3 monitor, when it
+ * denies a power down (an interrupt arrived on the way down), returns with
+ * x19-x28 overwritten, against the SMC calling convention; a C caller up the
+ * stack then crashes on its own registers.
+ */
+static __always_inline unsigned long
+__invoke_psci_suspend_smc(unsigned long function_id, unsigned long arg0,
+			  unsigned long arg1)
+{
+	register unsigned long x0 asm("x0") = function_id;
+	register unsigned long x1 asm("x1") = arg0;
+	register unsigned long x2 asm("x2") = arg1;
+	register unsigned long x3 asm("x3") = 0;
+
+	asm volatile("smc #0"
+		     : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3)
+		     :
+		     : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+		       "x12", "x13", "x14", "x15", "x16", "x17",
+#ifndef CONFIG_SHADOW_CALL_STACK
+		       "x18",
+#endif
+		       "x19", "x20", "x21", "x22", "x23", "x24", "x25",
+		       "x26", "x27", "x28", "x30", "cc", "memory");
+	return x0;
+}
+
 static __always_inline int
 __psci_cpu_suspend(u32 fn, u32 state, unsigned long entry_point)
 {
 	int err;
 
-	err = invoke_psci_fn(fn, state, entry_point, 0);
+	if (IS_ENABLED(CONFIG_ARM64) && psci_conduit == SMCCC_CONDUIT_SMC)
+		err = __invoke_psci_suspend_smc(fn, state, entry_point);
+	else
+		err = invoke_psci_fn(fn, state, entry_point, 0);
 	return psci_to_linux_errno(err);
 }
 

+	firmware {
+		/* Alive Clock and Power Manager: DVFS (voltages by the firmware) */
+		acpm_ipc: power-management {
+			compatible = "samsung,exynos7885-acpm-ipc";
+			#clock-cells = <1>;
+			mboxes = <&ap2apm_mailbox>;
+			shmem = <&apm_sram>;
+		};
+	};
+
+	cpucl0_opp_table: opp-table-cpucl0 {
+		/* Cortex-A73; levels and minimum from the Samsung cpufreq DT, voltages are ACPM's */
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-936000000 {
+			opp-hz = /bits/ 64 <936000000>;
+		};
+
+		opp-1144000000 {
+			opp-hz = /bits/ 64 <1144000000>;
+		};
+
+		opp-1352000000 {
+			opp-hz = /bits/ 64 <1352000000>;
+		};
+
+		opp-1560000000 {
+			opp-hz = /bits/ 64 <1560000000>;
+		};
+
+		opp-1664000000 {
+			opp-hz = /bits/ 64 <1664000000>;
+		};
+
+		opp-1768000000 {
+			opp-hz = /bits/ 64 <1768000000>;
+		};
+	};
+
+	cpucl1_opp_table: opp-table-cpucl1 {
+		/* Cortex-A53; levels and minimum from the Samsung cpufreq DT, voltages are ACPM's */
+		compatible = "operating-points-v2";
+		opp-shared;
+

+			opp-hz = /bits/ 64 <1586000000>;
+		};
+
+		opp-1690000000 {
+			opp-hz = /bits/ 64 <1690000000>;
+		};
+	};
+
+	thermal-zones {
+		cpu-thermal {
+			/* polled: the TMU is read-only, see exynos7885_tmu.c */
+			polling-delay = <1000>;
+			polling-delay-passive = <250>;
+			thermal-sensors = <&tmu_cpu 0>;
+
+			trips {
+				cpu_alert: cpu-alert {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				cpu_hot: cpu-hot {
+					temperature = <90000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				cpu-crit {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";

+		ret = acpm_do_xfer(&acpm->handle, &xfer);
+		if (ret)
+			return dev_err_probe(dev, ret, "plugin %u: attach failed\n", id);
+		dev_info(dev, "plugin %u (%s) attached\n", id, name);

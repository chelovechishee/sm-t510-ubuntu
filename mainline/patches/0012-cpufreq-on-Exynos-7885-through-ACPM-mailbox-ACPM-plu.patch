+/*
+ * Exynos 7885/7904: DVFS goes through the "fvp" plugin on channel 1, which
+ * does not answer frequency queries; the CPU rates S-Boot leaves are known.
+ */
+static const struct acpm_clk_variant exynos7885_acpm_clks[] = {
+	ACPM_CLK("mif"),
+	ACPM_CLK("int"),
+	ACPM_CLK_BOOT("cpucl0", 1352000000),	/* Cortex-A73 */
+	ACPM_CLK_BOOT("cpucl1", 1014000000),	/* Cortex-A53 */
+	ACPM_CLK("g3d"),
+	ACPM_CLK("fsys"),
+	ACPM_CLK("cam"),
+	ACPM_CLK("disp"),
+	ACPM_CLK("aud"),
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos7885 = {
+	.clks = exynos7885_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos7885_acpm_clks),
+	.mbox_chan_id = 1,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
+	unsigned long rate;
 
-	return clk->handle->ops->dvfs.get_rate(clk->handle, clk->mbox_chan_id,
+	rate = clk->handle->ops->dvfs.get_rate(clk->handle, clk->mbox_chan_id,
 					       clk->id);
+	return rate ?: clk->rate;
 }
 
 static int acpm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 			     unsigned long parent_rate)
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
+	int ret;
 
-	return clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
-					       clk->id, rate);
+	ret = clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
+					      clk->id, rate);
+	if (!ret)
+		clk->rate = rate;
+	return ret;
 }
 

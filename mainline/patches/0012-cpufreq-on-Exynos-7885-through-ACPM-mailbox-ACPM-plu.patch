diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
index 942a2e9f0..29adee1ed 100644
--- a/drivers/firmware/samsung/exynos-acpm.c
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -13,6 +13,7 @@
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/find.h>
+#include <linux/firmware.h>
 #include <linux/firmware/samsung/exynos-acpm-protocol.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
@@ -28,6 +29,7 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/types.h>
+#include <linux/unaligned.h>
 
 #include "exynos-acpm.h"
 #include "exynos-acpm-dvfs.h"
@@ -40,6 +42,25 @@
 #define ACPM_TX_TIMEOUT_US		500000
 
 #define ACPM_GS101_INITDATA_BASE	0xa000
+#define ACPM_EXYNOS7885_INITDATA_BASE	0x4b80
+
+/*
+ * Dynamic plugins (Exynos 7885): the framework header starts with the offset
+ * and number of plugin descriptors. A plugin the firmware wants attached but
+ * that is not yet is loaded from a firmware file and attached by the AP.
+ */
+#define ACPM_FW_PLUGINS			0x0
+#define ACPM_FW_NUM_PLUGINS		0x4
+#define ACPM_PLUGIN_DESC_SIZE		44
+#define ACPM_PLUGIN_ID			0
+#define ACPM_PLUGIN_BASE		4
+#define ACPM_PLUGIN_IS_ATTACHED		28
+#define ACPM_PLUGIN_SIZE		32
+#define ACPM_PLUGIN_STAY_ATTACHED	36
+#define ACPM_PLUGIN_FW_NAME		40
+#define ACPM_PLUGIN_FW_NAME_MAX		64
+#define ACPM_PROTOCOL_PLUGIN_ID		GENMASK(28, 26)
+#define ACPM_PROTOCOL_DP_ATTACH		BIT(25)
 
 /**
  * struct acpm_shmem - shared memory configuration information.
@@ -183,10 +204,13 @@ struct acpm_info {
  * struct acpm_match_data - of_device_id data.
  * @initdata_base:	offset in SRAM where the channels configuration resides.
  * @acpm_clk_dev_name:	base name for the ACPM clocks device that we're registering.
+ * @plugin_chan:	channel of the framework to attach dynamic plugins on, or
+ *			0 when the firmware has none to attach.
  */
 struct acpm_match_data {
 	loff_t initdata_base;
 	const char *acpm_clk_dev_name;
+	unsigned int plugin_chan;
 };
 
 #define client_to_acpm_chan(c) container_of(c, struct acpm_chan, cl)
@@ -698,6 +722,74 @@ static const struct acpm_ops exynos_acpm_driver_ops = {
 	},
 };
 
+/* Read a NUL-terminated string from SRAM, which only takes 32-bit accesses. */
+static void acpm_read_sram_string(struct acpm_info *acpm, u32 off, char *buf,
+				  size_t len)
+{
+	size_t i;
+
+	for (i = 0; i + 4 <= len; i += 4)
+		put_unaligned_le32(readl(acpm->sram_base + off + i), buf + i);
+	buf[len - 1] = '\0';
+}
+
+static int acpm_attach_plugins(struct acpm_info *acpm, unsigned int chan)
+{
+	struct device *dev = acpm->dev;
+	void __iomem *initdata = (void __iomem *)acpm->shmem;
+	u32 plugins = readl(initdata + ACPM_FW_PLUGINS);
+	u32 num = readl(initdata + ACPM_FW_NUM_PLUGINS);
+	u32 i;
+
+	for (i = 0; i < num; i++) {
+		void __iomem *desc = acpm->sram_base + plugins +
+				     i * ACPM_PLUGIN_DESC_SIZE;
+		char name[ACPM_PLUGIN_FW_NAME_MAX];
+		const struct firmware *fw;
+		struct acpm_xfer xfer;
+		u32 id, base, size, cmd[4] = { };
+		size_t j;
+		int ret;
+
+		if (readl(desc + ACPM_PLUGIN_IS_ATTACHED) & 0xff ||
+		    !(readl(desc + ACPM_PLUGIN_STAY_ATTACHED) & 0xff) ||
+		    !readl(desc + ACPM_PLUGIN_FW_NAME))
+			continue;
+
+		id = readl(desc + ACPM_PLUGIN_ID);
+		base = readl(desc + ACPM_PLUGIN_BASE) & ~1;
+		size = readl(desc + ACPM_PLUGIN_SIZE);
+		acpm_read_sram_string(acpm, readl(desc + ACPM_PLUGIN_FW_NAME),
+				      name, sizeof(name));
+
+		ret = firmware_request_nowarn(&fw, name, dev);
+		if (ret) {
+			dev_info(dev, "plugin %u: no %s, left detached\n", id, name);
+			continue;
+		}
+		if (fw->size > size || !base) {
+			dev_err(dev, "plugin %u: %s does not fit (%zu > %u)\n",
+				id, name, fw->size, size);
+			release_firmware(fw);
+			continue;
+		}
+		for (j = 0; j + 4 <= fw->size; j += 4)
+			writel(get_unaligned_le32(fw->data + j),
+			       acpm->sram_base + base + j);
+		release_firmware(fw);
+
+		cmd[0] = FIELD_PREP(ACPM_PROTOCOL_PLUGIN_ID, id) |
+			 ACPM_PROTOCOL_DP_ATTACH;

diff --git a/drivers/thermal/samsung/exynos7885_tmu.c b/drivers/thermal/samsung/exynos7885_tmu.c
new file mode 100644
index 000000000..439f47c4b
--- /dev/null
+++ b/drivers/thermal/samsung/exynos7885_tmu.c
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Exynos 7885/7904 TMU, read-only
+ *
+ * The bootloader programs and starts the TMU; this driver only converts the
+ * current temperature codes, with the one-point trimming of the Samsung
+ * driver: T = code - TRIMINFO[sensor] + 25 C. Thresholds, interrupts and
+ * throttling are left to the thermal framework (polled thermal zones).
+ */
+
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#define TMU_REG_TRIMINFO(n)		(0x0 + 4 * (n))
+#define TMU_REG_CURRENT_TEMP1_0		0x40
+#define TMU_TEMP_SHIFT			9
+#define TMU_TEMP_MASK			0x1ff
+#define TMU_FIRST_POINT_TRIM		25
+#define TMU_MAX_SENSORS			2
+
+struct exynos7885_tmu_sensor {
+	void __iomem *base;
+	unsigned int id;
+};
+
+static int exynos7885_tmu_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct exynos7885_tmu_sensor *s = thermal_zone_device_priv(tz);
+	u32 code, error;
+
+	code = (readl(s->base + TMU_REG_CURRENT_TEMP1_0) >>
+		(TMU_TEMP_SHIFT * s->id)) & TMU_TEMP_MASK;
+	error = readl(s->base + TMU_REG_TRIMINFO(s->id)) & TMU_TEMP_MASK;
+	if (!code || !error)
+		return -EAGAIN;
+
+	*temp = ((int)code - (int)error + TMU_FIRST_POINT_TRIM) * 1000;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops exynos7885_tmu_ops = {
+	.get_temp = exynos7885_tmu_get_temp,
+};
+
+static int exynos7885_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	void __iomem *base;
+	unsigned int id;
+	int registered = 0;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	for (id = 0; id < TMU_MAX_SENSORS; id++) {
+		struct exynos7885_tmu_sensor *s;
+		struct thermal_zone_device *tz;
+
+		s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+		if (!s)
+			return -ENOMEM;
+		s->base = base;
+		s->id = id;
+
+		/* only sensors used by a thermal zone in DT */
+		tz = devm_thermal_of_zone_register(dev, id, s, &exynos7885_tmu_ops);
+		if (IS_ERR(tz)) {
+			if (PTR_ERR(tz) != -ENODEV)
+				return dev_err_probe(dev, PTR_ERR(tz),
+						     "sensor %u\n", id);
+			continue;
+		}
+		registered++;
+	}
+
+	return registered ? 0 : -ENODEV;
+}
+
+static const struct of_device_id exynos7885_tmu_of_match[] = {
+	{ .compatible = "samsung,exynos7885-tmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos7885_tmu_of_match);
+
+static struct platform_driver exynos7885_tmu_driver = {
+	.probe = exynos7885_tmu_probe,
+	.driver = {
+		.name = "exynos7885-tmu",
+		.of_match_table = exynos7885_tmu_of_match,
+	},
+};
+module_platform_driver(exynos7885_tmu_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos 7885 TMU (read-only) driver");
+MODULE_LICENSE("GPL");

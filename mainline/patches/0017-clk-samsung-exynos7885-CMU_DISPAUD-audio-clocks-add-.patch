+	     CLK_CON_GAT_GOUT_DISPAUD_PPMU_ABOX_PCLK, 21, 0, 0),
+};
+
+static const struct samsung_cmu_info dispaud_cmu_info __initconst = {
+	.pll_clks		= dispaud_pll_clks,

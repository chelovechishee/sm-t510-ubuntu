diff --git a/drivers/clk/samsung/clk-pll.c b/drivers/clk/samsung/clk-pll.c
index e74552846..b3ac14193 100644
--- a/drivers/clk/samsung/clk-pll.c
+++ b/drivers/clk/samsung/clk-pll.c
@@ -542,6 +542,12 @@ static const struct clk_ops samsung_pll0822x_clk_min_ops = {
 #define PLL0831X_LOCK_STAT_SHIFT	(29)
 #define PLL0831X_ENABLE_SHIFT		(31)
 
+/* K sits in PLL_CON5 (+0x8); PLL1431x of Exynos 7885 has it in PLL_CON3 (+0xc) */
+static inline unsigned int pll0831x_kdiv_offs(struct samsung_clk_pll *pll)
+{
+	return pll->type == pll_1431x ? 0xc : 0x8;
+}
+
 static unsigned long samsung_pll0831x_recalc_rate(struct clk_hw *hw,
 						  unsigned long parent_rate)
 {
@@ -551,7 +557,7 @@ static unsigned long samsung_pll0831x_recalc_rate(struct clk_hw *hw,
 	u64 fvco = parent_rate;
 
 	pll_con3 = readl_relaxed(pll->con_reg);
-	pll_con5 = readl_relaxed(pll->con_reg + 8);
+	pll_con5 = readl_relaxed(pll->con_reg + pll0831x_kdiv_offs(pll));
 	mdiv = (pll_con3 >> PLL0831X_MDIV_SHIFT) & PLL0831X_MDIV_MASK;
 	pdiv = (pll_con3 >> PLL0831X_PDIV_SHIFT) & PLL0831X_PDIV_MASK;
 	sdiv = (pll_con3 >> PLL0831X_SDIV_SHIFT) & PLL0831X_SDIV_MASK;
@@ -580,7 +586,7 @@ static int samsung_pll0831x_set_rate(struct clk_hw *hw, unsigned long drate,
 	}
 
 	pll_con3 = readl_relaxed(pll->con_reg);
-	pll_con5 = readl_relaxed(pll->con_reg + 8);
+	pll_con5 = readl_relaxed(pll->con_reg + pll0831x_kdiv_offs(pll));
 
 	/* Change PLL PMSK values */
 	pll_con3 &= ~((PLL0831X_MDIV_MASK << PLL0831X_MDIV_SHIFT) |
@@ -601,7 +607,7 @@ static int samsung_pll0831x_set_rate(struct clk_hw *hw, unsigned long drate,
 
 	/* Write PMSK values */
 	writel_relaxed(pll_con3, pll->con_reg);
-	writel_relaxed(pll_con5, pll->con_reg + 8);
+	writel_relaxed(pll_con5, pll->con_reg + pll0831x_kdiv_offs(pll));
 
 	/* Wait for PLL lock if the PLL is enabled */
 	if (pll_con3 & BIT(pll->enable_offs))
@@ -1682,6 +1688,7 @@ static void __init _samsung_clk_register_pll(struct samsung_clk_provider *ctx,
 			init.ops = &samsung_pll36xx_clk_ops;
 		break;
 	case pll_0831x:
+	case pll_1431x:
 		pll->enable_offs = PLL0831X_ENABLE_SHIFT;
 		pll->lock_offs = PLL0831X_LOCK_STAT_SHIFT;
 		if (!pll->rate_count)

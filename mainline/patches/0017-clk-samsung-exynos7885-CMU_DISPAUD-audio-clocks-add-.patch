+	GATE(CLK_GOUT_ABOX_BCLK_UAIF0, "gout_abox_bclk_uaif0", "mout_aud_uaif0",
+	     CLK_CON_GAT_GOUT_DISPAUD_ABOX_BCLK_UAIF0, 21, 0, 0),
+	GATE(CLK_GOUT_ABOX_BCLK_UAIF2, "gout_abox_bclk_uaif2", "mout_aud_uaif2",
+	     CLK_CON_GAT_GOUT_DISPAUD_ABOX_BCLK_UAIF2, 21, 0, 0),
+	GATE(CLK_GOUT_ABOX_BCLK_UAIF3, "gout_abox_bclk_uaif3", "mout_aud_uaif3",
+	     CLK_CON_GAT_GOUT_DISPAUD_ABOX_BCLK_UAIF3, 21, 0, 0),
+	GATE(CLK_GOUT_AUD_CODEC_MCLK, "gout_aud_codec_mclk", "dout_aud_audif",
+	     CLK_CON_GAT_GOUT_DISPAUD_AUD_CODEC_MCLK, 21, 0, 0),
+	GATE(CLK_GOUT_SMMU_ABOX_CLK, "gout_smmu_abox_clk", "dout_aud_bus",
+	     CLK_CON_GAT_GOUT_DISPAUD_SMMU_ABOX_CLK, 21, 0, 0),
+	GATE(CLK_GOUT_WDT_ABOXCPU_PCLK, "gout_wdt_aboxcpu_pclk", "dout_aud_bus",
+	     CLK_CON_GAT_GOUT_DISPAUD_WDT_ABOXCPU_PCLK, 21, 0, 0),
+	GATE(CLK_GOUT_AUD_UAIF0_RSTNSYNC, "gout_aud_uaif0_rstnsync", "mout_aud_uaif0",
+	     CLK_CON_GAT_GOUT_DISPAUD_RSTNSYNC_AUD_UAIF0, 21, 0, 0),
+	GATE(CLK_GOUT_AUD_UAIF2_RSTNSYNC, "gout_aud_uaif2_rstnsync", "mout_aud_uaif2",

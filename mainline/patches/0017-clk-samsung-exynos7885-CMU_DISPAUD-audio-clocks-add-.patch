From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 17/52] clk: samsung: exynos7885: CMU_DISPAUD audio clocks; add
 PLL1431x

PLL1431x is PLL0831x with K in PLL_CON3 (+0xc). Only the ABOX/UAIF part of
CMU_DISPAUD is described; the display clocks stay as S-Boot set them.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos7885.dtsi |  10 ++
 drivers/clk/samsung/clk-exynos7885.c       | 156 +++++++++++++++++++++
 drivers/clk/samsung/clk-pll.c              |  13 +-
 drivers/clk/samsung/clk-pll.h              |   1 +
 include/dt-bindings/clock/exynos7885.h     |  37 +++++
 5 files changed, 214 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7885.dtsi b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
index edd6adffa..8140994ee 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
@@ -440,6 +440,16 @@ cmu_top: clock-controller@12060000 {
 			clock-names = "oscclk";
 		};
 
+		/* audio part only, see drivers/clk/samsung/clk-exynos7885.c */
+		cmu_dispaud: clock-controller@14800000 {
+			compatible = "samsung,exynos7885-cmu-dispaud";
+			reg = <0x14800000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>;
+			clock-names = "oscclk";
+		};
+
 		cmu_fsys: clock-controller@13400000 {
 			compatible = "samsung,exynos7885-cmu-fsys";
 			reg = <0x13400000 0x8000>;
diff --git a/drivers/clk/samsung/clk-exynos7885.c b/drivers/clk/samsung/clk-exynos7885.c

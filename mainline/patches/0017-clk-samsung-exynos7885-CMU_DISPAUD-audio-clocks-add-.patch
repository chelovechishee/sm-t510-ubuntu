+	GATE(CLK_GOUT_AUD_PERI_AXI_ASB_PCLK, "gout_aud_peri_axi_asb_pclk", "dout_aud_bus",
+	     CLK_CON_GAT_GOUT_DISPAUD_PERI_AXI_ASB_PCLK, 21, 0, 0),

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chelovechishee <261262090+chelovechishee@users.noreply.github.com>
Subject: [PATCH 24/38] drm/tiny: add Exynos 7885 DECON KMS on the bootloader
 setup; arm64: dts: exynos7885/gta3xlwifi: DECON, Mali-G71

S-Boot leaves DECON0 (video mode), DSIM and the panel running and scans out
through DPU DMA channel G0. exynos7885-decon keeps that setup and exposes it
as KMS: page flips write the framebuffer address into IDMA_IN_BASE_ADDR_Y
and request a shadow update, which DECON latches at the next frame start;
the frame-start interrupt drives vblank events. Buffers are GEM DMA (CMA):
the DPU SysMMU is in bypass. CRTC off shows the (blanked) boot framebuffer
and turns the backlight off.

The Mali-G71 MP2 (r0p0) runs on Panfrost. S-Boot leaves the G3D power
domain on and PLL_G3D at 343 MHz; the ACPM G3D clock reports that rate
(no DVFS yet).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos7885.dtsi    |  26 ++
 .../boot/dts/exynos/exynos7904-gta3xlwifi.dts |  17 +-
 drivers/clk/samsung/clk-acpm.c                |   2 +-
 drivers/gpu/drm/tiny/Kconfig                  |  15 +
 drivers/gpu/drm/tiny/Makefile                 |   1 +
 drivers/gpu/drm/tiny/exynos7885-decon.c       | 405 ++++++++++++++++++
 6 files changed, 463 insertions(+), 3 deletions(-)
 create mode 100644 drivers/gpu/drm/tiny/exynos7885-decon.c

diff --git a/arch/arm64/boot/dts/exynos/exynos7885.dtsi b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
index 8140994ee..bc544d005 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
@@ -790,6 +790,32 @@ i2c_7: i2c@11cd0000 {
 
 			status = "disabled";
 		};
+
+		/*
+		 * Scanout as left by the bootloader: DECON0 and the DPU DMA
+		 * channel G0 it reads from
+		 */
+		decon: display-controller@14860000 {
+			compatible = "samsung,exynos7885-decon";
+			reg = <0x14860000 0x1000>, <0x148b1000 0x100>;
+			reg-names = "decon", "idma";
+			interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "frame-start";
+			status = "disabled";
+		};
+
+		/* Mali-G71 MP2; S-Boot leaves the G3D domain on, PLL_G3D at 343 MHz */
+		gpu: gpu@11500000 {
+			compatible = "samsung,exynos7885-mali", "arm,mali-bifrost";
+			reg = <0x11500000 0x5000>;
+			interrupts = <GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "job", "mmu", "gpu";
+			clocks = <&acpm_ipc 4>;	/* G3D */
+			#cooling-cells = <2>;
+			status = "disabled";
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
index e046061ce..fa63c4475 100644
--- a/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7904-gta3xlwifi.dts
@@ -108,7 +108,7 @@ abox@e9400000 {
 			no-map;
 		};
 
-		framebuffer@ec000000 {
+		boot_fb: framebuffer@ec000000 {
 			reg = <0x0 0xec000000 0x1400000>;
 			no-map;
 		};
@@ -140,7 +140,7 @@ tsp_dvdd: regulator-tsp-dvdd {
 	};
 
 	/* panel brightness through the DSIM left running by S-Boot */
-	backlight@14870000 {
+	backlight: backlight@14870000 {
 		compatible = "samsung,gta3xlwifi-backlight";
 		reg = <0x0 0x14870000 0x100>;
 	};
@@ -596,3 +596,16 @@ reboot-mode {
 		mode-recovery = <0x12345674>;
 	};
 };
+
+&decon {
+	memory-region = <&boot_fb>;
+	backlight = <&backlight>;
+	/* 10.1" 16:10 panel */
+	width-mm = <136>;
+	height-mm = <217>;
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};

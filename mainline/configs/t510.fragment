# SM-T510 mainline kernel config fragment.
# Applied on top of allnoconfig: make allnoconfig KCONFIG_ALLCONFIG=...
CONFIG_LOCALVERSION="-t510"
CONFIG_ARCH_EXYNOS=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_VA_BITS_39=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_MAGIC_SYSRQ=y

# SoC
CONFIG_OF=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_SAMSUNG=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_SOC_SAMSUNG=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_EXYNOS_PMU=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_GPIOLIB=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y

# eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_EXYNOS=y

# Screen: framebuffer left running by S-Boot
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GTA3XL=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# KMS on the DECON setup S-Boot leaves running; Mali-G71 through Panfrost
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_EXYNOS7885_DECON=y
CONFIG_DRM_PANFROST=y
# GPU throttling by the G3D TMU (Panfrost registers as a devfreq cooling device)
CONFIG_DEVFREQ_THERMAL=y

# Keys
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# Debug channel: ramoops shared with the downstream kernel
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# Lockups panic; a panic stays on screen (restore via Download mode)
CONFIG_PANIC_TIMEOUT=0
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y

# USB gadget (phase 1): dwc3 + Exynos USB DRD PHY, RNDIS + ACM via configfs;
# mass storage: the tablet as a USB disk for a PC (t510-usb-disk)
CONFIG_GENERIC_PHY=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# Debug: busybox devmem for register dumps from init (bring-up only)
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n

# Ubuntu userspace (systemd 255 now, 259 for 26.04: cgroup v2 only)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_KEYS=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_FW_LOADER=y
CONFIG_IPV6=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CHECKPOINT_RESTORE=y
# swap in zram (zram-manual.service)
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZO=y
# zram compresses with its own backends: without them only lzo-rle exists and
# zram-manual's "zstd" silently fell back to it
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# multi-gen LRU: better page reclaim choices with 2 GB of RAM
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_BLK_DEV_LOOP=y

# Phase 2: touchscreen (STM FTS1BA90A on i2c_4, supplies from gpg3)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_S3C2410=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_STM_FTS1BA90A=y

# Phase 2: battery fuel gauge (S2MU005 on i2c_0); the S2MU005 charger/MUIC
# stay off for now: they switch USB modes and the port is behind a CCIC
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_S2MU005=y

# Phase 3: SPEEDY bus (PMIC S2MPU08 and the codec behind it)
CONFIG_I2C_EXYNOS_SPEEDY=y
CONFIG_MFD_SEC_I2C=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_S5M=y
CONFIG_RTC_INTF_DEV=y
CONFIG_REGULATOR_S2MPS11=y

# CPU DVFS through the ACPM firmware + thermal throttling; the fvp plugin is
# loaded from /lib/firmware (Samsung's, never built in: t510-firmware)
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_EXYNOS_ACPM_CLK=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
# cpuidle: core power down through PSCI (exynos7885-pmu clears the PMU power
# request); the tick runs on the MCT local timers, which survive it
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_EXYNOS7885_THERMAL=y

# Wi-Fi/BT: Samsung SCSC Maxwell core (drivers/misc/samsung/scsc)
CONFIG_SCSC_CORE=y
CONFIG_SCSC_PLATFORM=y
CONFIG_SCSC_CM_MX_CLIENT_TEST=y
CONFIG_SCSC_CORE_FW_LOCATION="/vendor/etc/wifi"
# Bluetooth: the SCSC BT service as hci0 for BlueZ (drivers/misc/samsung/scsc_bt)
CONFIG_SCSC_BT=y

# Wi-Fi: cfg80211 + Samsung SCSC wlan driver (drivers/net/wireless/scsc)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_SCSC_WLAN=y
CONFIG_SCSC_WLAN_KEY_MGMT_OFFLOAD=n
CONFIG_SCSC_WLAN_ANDROID=n
CONFIG_SCSC_WLAN_GSCAN_ENABLE=n
CONFIG_SCSC_WLAN_WES_NCHO=n
CONFIG_SCSC_WLAN_HANG_TEST=n
CONFIG_SCSC_WLAN_AP_INFO_FILE=n
CONFIG_SCSC_WLAN_ENABLE_MAC_RANDOMISATION=n
CONFIG_SCSC_WLAN_ACS_ENABLE=n
CONFIG_SLSI_WLAN_STA_FWD_BEACON=n
# as in the Samsung 4.4 build
CONFIG_SCSC_WLAN_SG=y
CONFIG_SCSC_WLAN_PSCHED_AMSDU=y
CONFIG_SCSC_WLAN_HIP_SUPPORT_SCATTER_GATHER_API=y

# Accelerometer ST LIS2DS12 on USI2 HSI2C1 (screen rotation hint)
CONFIG_EXYNOS_USI=y
CONFIG_I2C_EXYNOS5=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_IIO_ST_ACCEL_3AXIS=y
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=y

# Sound: Samsung ABOX (work in progress); ABOX powers its DSP from runtime PM
CONFIG_PM=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_SND_SOC_SAMSUNG_ABOX=y
CONFIG_SND_SOC_SAMSUNG_GTA3XL=y
CONFIG_SND_SOC_TFA989X=y
# ABOX maps its DSP address space itself: DMA API addresses must be physical
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y
# ABOX allocates its 12 MB DSP firmware area with dma_alloc_coherent(); KMS
# scanout buffers (9 MB each: fbdev, X front buffer, rotation shadow) too;
# a full size camera photo needs about 80 MB (raw frames of 16 MB each)
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# Suspend: s2idle first (PSCI 0.1 from DT has no SYSTEM_SUSPEND);
# /sys/power/pm_test steps through freezer, devices, platform, processors, core
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# Networking for VPN clients (Happ/Xray TUN mode, WireGuard, NetworkManager);
# iptables goes through nftables (iptables-nft), no legacy tables
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_INET_DIAG=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y

# desktop basics: FUSE (xdg-document-portal, gvfs-fuse, sshfs,
# AppImage), overlay/squashfs, file systems of USB sticks, SD cards, discs and
# network shares, uinput/uhid/hidraw, binfmt_misc
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_866=y
CONFIG_NLS_CODEPAGE_1251=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_KOI8_R=y
CONFIG_NLS_UTF8=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_CIFS=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_BINFMT_MISC=y

# S2MU005 charger: currents by the MUIC BC1.2 result (s2m-charger without MUIC node)
CONFIG_EXTCON=y
CONFIG_CHARGER_S2M=y

# USB host/OTG: the S2MM005 CCIC switches dwc3 between device and host and
# turns on the S2MU005 OTG boost; devices on the port: storage, keyboards and
# mice, network adapters, sound cards, webcams, serial adapters, Bluetooth
CONFIG_TYPEC=y
CONFIG_TYPEC_S2MM005=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_APPLE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_USB_ACM=y
CONFIG_USB_PRINTER=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_IPHETH=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_S5K4HA=y
CONFIG_VIDEO_S5K5E9=y
CONFIG_VIDEO_CAMERA_LENS=y
CONFIG_VIDEO_DW9807_VCM=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_EXYNOS7885_CSIS=y
# buffers for the libcamera software ISP
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y

# Bluetooth: BlueZ core and profiles; USB dongles too
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_POLL_SYNC=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIVHCI=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y
